---
import { siteConfig } from '../config/site.js';
---

<footer class="footer">
  <div class="container footer-content">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand-link">
          <div class="brand-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="16" rx="3" stroke="#0f172a" />
              <line x1="7" y1="8" x2="7" y2="12" stroke="#0f172a" />
              <line x1="10" y1="8" x2="10" y2="12" stroke="#0f172a" />
              <line x1="13" y1="8" x2="13" y2="12" stroke="#0f172a" />
              <line x1="17" y1="8" x2="17" y2="12" stroke="#0f172a" />
              <line x1="7" y1="15" x2="17" y2="15" stroke="#64748b" />
            </svg>
          </div>
          <span class="brand-title font-sans">LabelCrop<span class="brand-suffix">Now</span></span>
        </a>
        <p class="brand-desc">
          100% Client-Side shipping label cropper, SKU batch sorter, A4 4-Up grid builder, and offline Zebra ZPL II converter for Indian & US e-commerce sellers.
        </p>
        <div class="privacy-callout">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <polyline points="9 12 11 14 15 10"/>
          </svg>
          <span><strong>Zero-Upload Privacy Guarantee:</strong> All label processing executes in local browser RAM. Customer addresses, order IDs, and GST tax invoices never leave your computer.</span>
        </div>
      </div>

      <div class="footer-col">
        <h4 class="col-title font-serif">Indian Marketplaces</h4>
        <ul class="col-links font-sans">
          <li><a href="/crop/meesho">Meesho Label Cropper</a></li>
          <li><a href="/crop/flipkart">Flipkart Ekart 4×6</a></li>
          <li><a href="/crop/amazon-india">Amazon India Easy Ship</a></li>
          <li><a href="/crop/meesho-sku-sort">Meesho SKU & Courier Sort</a></li>
          <li><a href="/crop/meesho-a4-4-labels-per-page">Meesho A4 4-Up Grid</a></li>
          <li><a href="/crop/shiprocket">Shiprocket Courier Sorter</a></li>
          <li><a href="/crop/delhivery">Delhivery Direct Crop</a></li>
          <li><a href="/crop/shopsy">Shopsy Label Cropper</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="col-title font-serif">US & Global Sellers</h4>
        <ul class="col-links font-sans">
          <li><a href="/us/amazon-fba-8-5x11-to-4x6">Amazon FBA 8.5×11 to 4×6</a></li>
          <li><a href="/us/usps-click-n-ship-4x6-cropper">USPS Click-N-Ship 4×6</a></li>
          <li><a href="/us/ups-shipping-label-cropper">UPS Shipping Label Cropper</a></li>
          <li><a href="/us/fedex-shipping-label-cropper">FedEx Ship Manager 4×6</a></li>
          <li><a href="/us/ebay-shipping-label-to-4x6">eBay Label to 4×6</a></li>
          <li><a href="/us/poshmark-label-to-4x6">Poshmark 4×6 Cropper</a></li>
          <li><a href="/us/rollo-printer-pdf-label-cropper">Rollo Thermal Cropper</a></li>
          <li><a href="/us/zebra-printer-4x6-pdf-converter">Zebra Desktop 4×6</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="col-title font-serif">Warehouse Utilities</h4>
        <ul class="col-links font-sans">
          <li><a href="/shopify-calculator">Shopify Profit Calculator</a></li>
          <li><a href="/low-shipping">Low Shipping Generator</a></li>
          <li><a href="/barcode-generator">Barcode & Price Tag Generator</a></li>
          <li><a href="/image-compressor">Free Image Compressor</a></li>
          <li><a href="/image-converter">Free Image Converter</a></li>
          <li><a href="/whatsapp">WhatsApp Direct Message</a></li>
          <li><a href="/zpl-to-pdf-converter">Offline ZPL to PDF</a></li>
          <li><a href="/a4-4-labels-per-page-converter">A4 4-Up Grid Maker</a></li>
          <li><a href="/sort-shipping-labels-by-sku">Sort Labels by SKU</a></li>
          <li><a href="/manifest-generator">Courier Pickup Manifest</a></li>
          <li><a href="/supported-marketplaces">All Marketplaces & Printers</a></li>
        </ul>
      </div>
    </div>

    <!-- Brand & Trademark Disclaimers -->
    <div class="footer-attribution font-mono">
      <p>Brand logos and registered trademarks belong to their respective corporate owners and are used strictly for compatibility identification. LabelCropNow is an independent tool and is not endorsed by or affiliated with any marketplace, courier, or printer manufacturer.</p>
    </div>

    <div class="footer-bottom">
      <div class="copyright font-sans">
        © {new Date().getFullYear()} {siteConfig.name}. Designed for independent marketplace sellers worldwide. Zero telemetry.
      </div>
      <div class="legal-links font-sans">
        <a href="/about">About</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/contact">Contact</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #f8fafc;
    border-top: 1px solid var(--border-subtle);
    padding: 4rem 0 2rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    margin-bottom: 0.85rem;
  }

  .brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
  }

  .brand-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.02em;
  }

  .brand-suffix {
    color: #475569;
    font-weight: 600;
  }

  .brand-desc {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
    margin-bottom: 1.5rem;
    max-width: 360px;
  }

  .privacy-callout {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    border-radius: 12px;
    font-size: 0.82rem;
    color: #065f46;
    line-height: 1.45;
  }

  .privacy-callout svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .privacy-callout strong {
    color: #047857;
  }

  .col-title {
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--text-main);
    margin-bottom: 1.15rem;
    letter-spacing: -0.01em;
  }

  .col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .col-links a {
    color: var(--text-muted);
    font-size: 0.86rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .col-links a:hover {
    color: var(--text-main);
    text-decoration: underline;
  }

  .footer-attribution {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.72rem;
    color: var(--text-dim);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    font-size: 0.82rem;
    color: var(--text-dim);
  }

  .legal-links {
    display: flex;
    gap: 1.5rem;
  }

  .legal-links a {
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .legal-links a:hover {
    color: var(--text-main);
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
