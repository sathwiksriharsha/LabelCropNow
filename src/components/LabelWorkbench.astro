<script>
  import { PDFDocument } from 'pdf-lib';
  import {
    getSamplePdfForPreset,
    generateMeeshoSamplePdf,
    generateFlipkartSamplePdf,
    generateAmazonFbaSamplePdf,
    generateTikTokShopSamplePdf
  } from '../utils/samplePdfGenerator.js';
  import { parsePdfLabels, sortPagesBySku, sortPagesByCourier, sortHighlightMultiQty } from '../utils/labelParser.js';
  import { cropPdfLabels } from '../utils/pdfCropEngine.js';

  // Application State
  let rawPdfBytes: Uint8Array | null = null;
  let parsedMetadata: any[] = [];
  let currentFileName = 'shipping_labels.pdf';
  let loadedAccounts: { name: string; pageCount: number }[] = [];
  let activeGroups: { id: string; label: string; pageIndices: number[]; count: number; isMulti: boolean }[] = [];
  let excludedGroupIds = new Set<string>();

  // DOM Elements
  const dropzone = document.getElementById('dropzone')!;
  const fileInput = document.getElementById('fileInput') as HTMLInputElement;
  const addAccountInput = document.getElementById('addAccountInput') as HTMLInputElement | null;
  const accountsChipRow = document.getElementById('accountsChipRow')!;
  const mapGroupsContainer = document.getElementById('mapGroupsContainer')!;
  const mapStatsBadge = document.getElementById('mapStatsBadge')!;

  const workbenchActive = document.getElementById('workbenchActive')!;
  const workbenchLoading = document.getElementById('workbenchLoading')!;
  const loadingText = document.getElementById('loadingText')!;
  const dispFileName = document.getElementById('dispFileName')!;
  const dispPageCount = document.getElementById('dispPageCount')!;
  const dispCourierTags = document.getElementById('dispCourierTags')!;
  const multiQtyAlert = document.getElementById('multiQtyAlert')!;
  const multiQtyTitle = document.getElementById('multiQtyTitle')!;
  const multiQtyDesc = document.getElementById('multiQtyDesc')!;

  const sliderTop = document.getElementById('sliderTop') as HTMLInputElement;
  const sliderBottom = document.getElementById('sliderBottom') as HTMLInputElement;
  const sliderLeft = document.getElementById('sliderLeft') as HTMLInputElement;
  const sliderRight = document.getElementById('sliderRight') as HTMLInputElement;

  const valTop = document.getElementById('valTop')!;
  const valBottom = document.getElementById('valBottom')!;
  const valLeft = document.getElementById('valLeft')!;
  const valRight = document.getElementById('valRight')!;

  const previewCanvas = document.getElementById('previewCanvas') as HTMLCanvasElement;
  const btnDownload = document.getElementById('btnDownload') as HTMLButtonElement;
  const btnPrint = document.getElementById('btnPrint') as HTMLButtonElement;
  const btnReset = document.getElementById('btnReset') as HTMLButtonElement;

  const btnDynamicSample = document.getElementById('btnDynamicSample');
  const btnSampleMeesho = document.getElementById('btnSampleMeesho');
  const btnSampleFlipkart = document.getElementById('btnSampleFlipkart');
  const btnSampleTikTok = document.getElementById('btnSampleTikTok');
  const btnSampleFba = document.getElementById('btnSampleFba');

  // Marketplace Capsule Tab Switcher (Universal Workbench)
  const mpTabs = document.querySelectorAll('.mp-tab');
  const dropzoneTitle = document.getElementById('dropzoneTitle');
  const presetNameDisplay = document.querySelector('.preset-name');

  const marketConfigs: Record<string, { name: string; title: string; bottom: number }> = {
    meesho: {
      name: 'Meesho Shipping Label Cropper',
      title: 'Drop your Meesho Ready-to-Ship PDF here',
      bottom: 50,
    },
    amazon: {
      name: 'Amazon India Easy Ship & FBA Cropper',
      title: 'Drop your Amazon Easy Ship or FBA PDF here',
      bottom: 0,
    },
    flipkart: {
      name: 'Flipkart Ekart Shipping Label Cropper',
      title: 'Drop your Flipkart Ekart Shipping PDF here',
      bottom: 50,
    },
    tiktok: {
      name: 'TikTok Shop Shipping Label Cropper',
      title: 'Drop your TikTok Shop Order PDF here',
      bottom: 0,
    },
    shiprocket: {
      name: 'Shiprocket Multi-Carrier Cropper',
      title: 'Drop your Shiprocket Dispatch PDF here',
      bottom: 0,
    },
    usps: {
      name: 'USPS & Amazon FBA 4×6 Cropper',
      title: 'Drop your USPS, UPS or FBA Label PDF here',
      bottom: 0,
    }
  };

  mpTabs.forEach((tab) => {
    tab.addEventListener('click', (e) => {
      e.stopPropagation();
      mpTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      const market = tab.getAttribute('data-market') || 'meesho';
      const cfg = marketConfigs[market];
      if (cfg) {
        if (presetNameDisplay) presetNameDisplay.textContent = cfg.name;
        if (dropzoneTitle) dropzoneTitle.textContent = cfg.title;
        sliderBottom.value = String(cfg.bottom);
        valBottom.textContent = `${cfg.bottom}%`;
        renderVisualCropOverlay();
      }
    });
  });

  // Dynamic Contextual Sample Button for Preset Pages (e.g. TikTok, USPS, Flipkart)
  btnDynamicSample?.addEventListener('click', async (e) => {
    e.stopPropagation();
    const slug = btnDynamicSample.getAttribute('data-slug') || '';
    showLoading(`Generating realistic sample label for ${slug}...`);
    try {
      const res = await getSamplePdfForPreset(slug);
      await processPdfBuffer(res.bytes, res.filename);
    } catch (err) {
      console.error(err);
      const bytes = await generateMeeshoSamplePdf();
      await processPdfBuffer(bytes, 'sample_shipping_label.pdf');
    }
  });

  btnSampleTikTok?.addEventListener('click', async (e) => {
    e.stopPropagation();
    showLoading('Generating TikTok Shop 4x6 Sample PDF...');
    const bytes = await generateTikTokShopSamplePdf();
    await processPdfBuffer(bytes, 'sample_tiktok_shop_label.pdf');
  });

  // Sliders event listeners
  [sliderTop, sliderBottom, sliderLeft, sliderRight].forEach((slider) => {
    slider?.addEventListener('input', () => {
      valTop.textContent = `${sliderTop.value}%`;
      valBottom.textContent = `${sliderBottom.value}%`;
      valLeft.textContent = `${sliderLeft.value}%`;
      valRight.textContent = `${sliderRight.value}%`;
      renderVisualCropOverlay();
    });
  });

  // Sort Option Change listener triggers Preview Map rebuild
  document.querySelectorAll('input[name="sortOption"]').forEach((radio) => {
    radio.addEventListener('change', () => {
      rebuildPreviewMap();
    });
  });

  // Dynamic Sample Button (on Preset Pages)
  btnDynamicSample?.addEventListener('click', async (e) => {
    e.stopPropagation();
    const slug = btnDynamicSample.getAttribute('data-slug') || 'meesho';
    showLoading(`Generating realistic sample PDF for ${slug}...`);
    const bytes = await getSamplePdfForPreset(slug);
    loadedAccounts = [{ name: `${slug}_demo_orders.pdf`, pageCount: 6 }];
    await processPdfBuffer(bytes, `${slug}_demo_orders.pdf`);
  });

  // Sample Buttons
  btnSampleMeesho?.addEventListener('click', async (e) => {
    e.stopPropagation();
    showLoading('Generating 6-Page Meesho Ready-to-Ship PDF in memory...');
    const bytes = await generateMeeshoSamplePdf();
    loadedAccounts = [{ name: 'meesho_sample_ready_to_ship.pdf', pageCount: 6 }];
    await processPdfBuffer(bytes, 'meesho_sample_ready_to_ship.pdf');
  });

  btnSampleFlipkart?.addEventListener('click', async (e) => {
    e.stopPropagation();
    showLoading('Generating Flipkart Ekart Sample PDF...');
    const bytes = await generateFlipkartSamplePdf();
    loadedAccounts = [{ name: 'flipkart_ekart_sample.pdf', pageCount: 6 }];
    await processPdfBuffer(bytes, 'flipkart_ekart_sample.pdf');
  });

  btnSampleTikTok?.addEventListener('click', async (e) => {
    e.stopPropagation();
    showLoading('Generating TikTok Shop Sample PDF...');
    const bytes = await generateTikTokShopSamplePdf();
    loadedAccounts = [{ name: 'tiktok_shop_sample.pdf', pageCount: 6 }];
    await processPdfBuffer(bytes, 'tiktok_shop_sample.pdf');
  });

  btnSampleFba?.addEventListener('click', async (e) => {
    e.stopPropagation();
    showLoading('Generating Amazon FBA 8.5x11 Sample PDF...');
    const bytes = await generateAmazonFbaSamplePdf();
    loadedAccounts = [{ name: 'amazon_fba_inbound_sample.pdf', pageCount: 6 }];
    await processPdfBuffer(bytes, 'amazon_fba_inbound_sample.pdf');
  });

  // Drag and drop events
  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('dragover');
  });

  dropzone.addEventListener('dragleave', () => {
    dropzone.classList.remove('dragover');
  });

  dropzone.addEventListener('drop', async (e) => {
    e.preventDefault();
    dropzone.classList.remove('dragover');
    const files = e.dataTransfer?.files;
    if (files && files.length > 0) {
      await loadUserFiles(files);
    }
  });

  fileInput.addEventListener('change', async () => {
    if (fileInput.files && fileInput.files.length > 0) {
      await loadUserFiles(fileInput.files);
    }
  });

  addAccountInput?.addEventListener('change', async () => {
    if (addAccountInput.files && addAccountInput.files.length > 0) {
      await loadUserFiles(addAccountInput.files);
      addAccountInput.value = '';
    }
  });

  // Multi-account file loader & merger
  async function loadUserFiles(files: FileList | File[]) {
    const fileArr = Array.from(files).filter((f) => f.type === 'application/pdf' || f.name.toLowerCase().endsWith('.pdf'));
    if (fileArr.length === 0) return;

    showLoading(`Merging & reading ${fileArr.length} file(s) into browser RAM...`);

    try {
      if (fileArr.length === 1 && loadedAccounts.length === 0) {
        const file = fileArr[0];
        const buffer = await file.arrayBuffer();
        const bytes = new Uint8Array(buffer);
        const doc = await PDFDocument.load(bytes);
        loadedAccounts = [{ name: file.name, pageCount: doc.getPageCount() }];
        await processPdfBuffer(bytes, file.name);
      } else {
        const mergedDoc = await PDFDocument.create();
        const accounts: { name: string; pageCount: number }[] = [];

        // Retain existing loaded document pages if merging an additional account
        if (rawPdfBytes && loadedAccounts.length > 0) {
          const existingDoc = await PDFDocument.load(rawPdfBytes);
          const existingPages = await mergedDoc.copyPages(existingDoc, existingDoc.getPageIndices());
          existingPages.forEach((p) => mergedDoc.addPage(p));
          accounts.push(...loadedAccounts);
        }

        for (const file of fileArr) {
          const bytes = new Uint8Array(await file.arrayBuffer());
          const doc = await PDFDocument.load(bytes);
          const pageIndices = doc.getPageIndices();
          const copied = await mergedDoc.copyPages(doc, pageIndices);
          copied.forEach((p) => mergedDoc.addPage(p));
          accounts.push({ name: file.name, pageCount: pageIndices.length });
        }

        const mergedBytes = await mergedDoc.save();
        loadedAccounts = accounts;
        const combinedName = accounts.length > 1 ? `${accounts.length}_accounts_combined.pdf` : accounts[0].name;
        await processPdfBuffer(mergedBytes, combinedName);
      }
    } catch (err: any) {
      alert(`Error reading PDF file(s): ${err.message}`);
      workbenchLoading.style.display = 'none';
      if (!rawPdfBytes) dropzone.style.display = 'block';
    }
  }

  function showLoading(msg: string) {
    dropzone.style.display = 'none';
    workbenchActive.style.display = 'none';
    workbenchLoading.style.display = 'flex';
    loadingText.textContent = msg;
  }

  async function processPdfBuffer(bytes: Uint8Array, filename: string) {
    rawPdfBytes = bytes;
    currentFileName = filename;

    loadingText.textContent = 'Parsing Courier Partners & SKUs...';
    try {
      parsedMetadata = await parsePdfLabels(bytes);
    } catch (err) {
      console.warn('Text parsing skipped, proceeding with vector crop:', err);
      parsedMetadata = [];
    }

    // Update UI elements
    dispFileName.textContent = filename;
    dispPageCount.textContent = `${parsedMetadata.length || 'Ready'} Pages`;

    // Render Couriers
    const couriers = Array.from(new Set(parsedMetadata.map((p) => p.courier)));
    dispCourierTags.innerHTML = couriers
      .map((c) => `<span class="badge badge-cyan">${c}</span>`)
      .join(' ');

    // Multi-account chips display
    if (loadedAccounts.length > 1) {
      accountsChipRow.style.display = 'flex';
      accountsChipRow.innerHTML = loadedAccounts
        .map(
          (acc, i) => `
        <span class="account-chip font-mono">
          <span class="acc-num">Account ${i + 1}:</span>
          <span class="acc-name" title="${acc.name}">${acc.name}</span>
          <span class="acc-count">(${acc.pageCount} pgs)</span>
        </span>
      `
        )
        .join('');
    } else {
      accountsChipRow.style.display = 'none';
    }

    // Multi-Qty Alert
    const multiCount = parsedMetadata.filter((p) => p.qty > 1).length;
    if (multiCount > 0) {
      multiQtyAlert.style.display = 'flex';
      multiQtyTitle.textContent = `${multiCount} Multi-Quantity Orders Detected!`;
      multiQtyDesc.textContent = `${multiCount} orders have multiple units. Highlighting active so packers never under-ship.`;
    } else {
      multiQtyAlert.style.display = 'none';
    }

    // Build interactive preview map
    rebuildPreviewMap();

    workbenchLoading.style.display = 'none';
    workbenchActive.style.display = 'block';

    const stepPill1 = document.getElementById('stepPill1');
    const stepPill2 = document.getElementById('stepPill2');
    stepPill1?.classList.remove('active');
    stepPill2?.classList.add('active');

    renderVisualCropOverlay();
  }

  // Rebuild preview map groups based on current sort option
  function rebuildPreviewMap() {
    const sortOpt = (document.querySelector('input[name="sortOption"]:checked') as HTMLInputElement)?.value || 'original';
    const groupsMap = new Map<string, { id: string; label: string; pageIndices: number[]; count: number; isMulti: boolean }>();

    parsedMetadata.forEach((p, idx) => {
      let groupKey = 'Default Batch';
      if (sortOpt === 'courier') {
        groupKey = p.courier || 'Other Courier';
      } else if (sortOpt === 'sku') {
        groupKey = p.sku || 'Unassigned SKU';
      } else if (sortOpt === 'multi_first') {
        groupKey = p.qty > 1 ? '⚠️ Multi-Quantity Orders' : 'Single Item Orders';
      } else {
        groupKey = p.courier || `Page Group ${Math.floor(idx / 4) + 1}`;
      }

      if (!groupsMap.has(groupKey)) {
        groupsMap.set(groupKey, {
          id: groupKey,
          label: groupKey,
          pageIndices: [],
          count: 0,
          isMulti: false
        });
      }
      const g = groupsMap.get(groupKey)!;
      g.pageIndices.push(p.pageIndex ?? idx);
      g.count++;
      if (p.qty > 1) g.isMulti = true;
    });

    activeGroups = Array.from(groupsMap.values());
    renderPreviewMapUI();
  }

  // Render preview map with interactive reordering and exclusion checkboxes
  function renderPreviewMapUI() {
    if (!mapGroupsContainer) return;

    let activeOrderCount = 0;
    let totalOrderCount = 0;

    activeGroups.forEach((g) => {
      totalOrderCount += g.count;
      if (!excludedGroupIds.has(g.id)) {
        activeOrderCount += g.count;
      }
    });

    if (mapStatsBadge) {
      mapStatsBadge.textContent = `${activeOrderCount} of ${totalOrderCount} labels active ${
        excludedGroupIds.size > 0 ? `(${totalOrderCount - activeOrderCount} excluded)` : ''
      }`;
    }

    mapGroupsContainer.innerHTML = activeGroups
      .map((g, idx) => {
        const isExcluded = excludedGroupIds.has(g.id);
        const isFirst = idx === 0;
        const isLast = idx === activeGroups.length - 1;

        return `
        <div class="map-group-card ${isExcluded ? 'excluded' : ''}" data-group-id="${g.id}">
          <div class="group-card-left">
            <label class="group-check-label">
              <input type="checkbox" class="chk-group-toggle" data-group-id="${g.id}" ${!isExcluded ? 'checked' : ''} />
              <span class="group-name font-sans">${g.label}</span>
            </label>
            <span class="group-count-badge font-mono">${g.count} order${g.count > 1 ? 's' : ''}</span>
            ${g.isMulti ? '<span class="badge badge-amber font-mono" style="font-size: 0.68rem;">[!] MULTI</span>' : ''}
          </div>
          <div class="group-card-actions">
            <button type="button" class="btn-group-move" data-action="up" data-index="${idx}" ${isFirst ? 'disabled' : ''} title="Move group up in dispatch print order">↑</button>
            <button type="button" class="btn-group-move" data-action="down" data-index="${idx}" ${isLast ? 'disabled' : ''} title="Move group down in dispatch print order">↓</button>
          </div>
        </div>
      `;
      })
      .join('');

    // Attach exclusion checkbox toggles
    mapGroupsContainer.querySelectorAll('.chk-group-toggle').forEach((chk) => {
      chk.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const gid = target.getAttribute('data-group-id');
        if (!gid) return;
        if (target.checked) {
          excludedGroupIds.delete(gid);
        } else {
          excludedGroupIds.add(gid);
        }
        renderPreviewMapUI();
      });
    });

    // Attach manual group reorder buttons
    mapGroupsContainer.querySelectorAll('.btn-group-move').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const action = btn.getAttribute('data-action');
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        if (action === 'up' && idx > 0) {
          const temp = activeGroups[idx];
          activeGroups[idx] = activeGroups[idx - 1];
          activeGroups[idx - 1] = temp;
          renderPreviewMapUI();
        } else if (action === 'down' && idx < activeGroups.length - 1) {
          const temp = activeGroups[idx];
          activeGroups[idx] = activeGroups[idx + 1];
          activeGroups[idx + 1] = temp;
          renderPreviewMapUI();
        }
      });
    });
  }

  function renderVisualCropOverlay() {
    const ctx = previewCanvas.getContext('2d');
    if (!ctx) return;

    const w = previewCanvas.width;
    const h = previewCanvas.height;

    // Draw background simulated PDF page (white sheet)
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, w, h);

    // Draw simulated label elements on page 1
    ctx.fillStyle = '#e2e8f0';
    ctx.fillRect(20, 20, w - 40, 15); // Header bar
    ctx.fillRect(20, 45, 120, 40);   // Simulated Barcode
    ctx.fillRect(20, 95, 160, 8);
    ctx.fillRect(20, 110, 200, 8);
    ctx.fillRect(20, 125, 140, 8);

    // Simulated bottom invoice section
    ctx.fillStyle = '#cbd5e1';
    ctx.fillRect(20, 230, w - 40, 10);
    ctx.fillRect(20, 250, w - 40, 120);

    // Calculate crop percentages
    const topP = parseInt(sliderTop.value, 10) / 100;
    const btmP = parseInt(sliderBottom.value, 10) / 100;
    const lftP = parseInt(sliderLeft.value, 10) / 100;
    const rgtP = parseInt(sliderRight.value, 10) / 100;

    const cropX = w * lftP;
    const cropY = h * topP;
    const cropW = w * (1 - lftP - rgtP);
    const cropH = h * (1 - topP - btmP);

    // Dim the cropped-out areas with a gentle translucent slate wash
    ctx.fillStyle = 'rgba(15, 23, 42, 0.45)';
    // Top strip
    ctx.fillRect(0, 0, w, cropY);
    // Bottom strip
    ctx.fillRect(0, cropY + cropH, w, h - (cropY + cropH));
    // Left strip
    ctx.fillRect(0, cropY, cropX, cropH);
    // Right strip
    ctx.fillRect(cropX + cropW, cropY, w - (cropX + cropW), cropH);

    // Draw high-contrast crop boundary box
    ctx.strokeStyle = '#059669';
    ctx.lineWidth = 2.5;
    ctx.strokeRect(cropX, cropY, cropW, cropH);

    // Draw active label tag
    ctx.fillStyle = '#059669';
    ctx.fillRect(cropX, Math.max(0, cropY - 18), 90, 18);
    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold 10px sans-serif';
    ctx.fillText('Cropped Label', cropX + 6, Math.max(12, cropY - 5));
  }

  // Execute Crop and Export
  btnDownload?.addEventListener('click', async () => {
    if (!rawPdfBytes) return;

    btnDownload.disabled = true;
    btnDownload.textContent = 'Processing Vector PDF...';

    try {
      const mode = (document.querySelector('input[name="layoutMode"]:checked') as HTMLInputElement)?.value as any || 'thermal4x6';
      const sortOpt = (document.querySelector('input[name="sortOption"]:checked') as HTMLInputElement)?.value || 'original';
      const stampMulti = (document.getElementById('chkStampMulti') as HTMLInputElement)?.checked ?? true;
      const appendManifest = (document.getElementById('chkManifest') as HTMLInputElement)?.checked ?? false;

      // Build final page order from preview map respecting manual reordering and exclusions
      const finalPageOrder: number[] = [];
      activeGroups.forEach((g) => {
        if (!excludedGroupIds.has(g.id)) {
          finalPageOrder.push(...g.pageIndices);
        }
      });

      if (finalPageOrder.length === 0) {
        alert('All groups are currently excluded! Please check at least one group in the Preview Map to export.');
        btnDownload.disabled = false;
        btnDownload.innerHTML = `
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Download Cropped PDF
        `;
        return;
      }

      const result = await cropPdfLabels(rawPdfBytes, {
        mode,
        margins: {
          topPercent: parseInt(sliderTop.value, 10),
          bottomPercent: parseInt(sliderBottom.value, 10),
          leftPercent: parseInt(sliderLeft.value, 10),
          rightPercent: parseInt(sliderRight.value, 10),
        },
        pageOrder: finalPageOrder,
        parsedPages: parsedMetadata,
        stampMultiQty: stampMulti,
        appendManifest,
      });

      // Trigger instant browser download
      const blob = new Blob([result.pdfBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `cropped_${mode}_${currentFileName}`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      const stepPill2 = document.getElementById('stepPill2');
      const stepPill3 = document.getElementById('stepPill3');
      stepPill2?.classList.remove('active');
      stepPill3?.classList.add('active');
    } catch (err: any) {
      alert(`Error generating cropped PDF: ${err.message}`);
      console.error(err);
    } finally {
      btnDownload.disabled = false;
      btnDownload.innerHTML = `
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Download Cropped PDF
      `;
    }
  });

  // Print button
  btnPrint?.addEventListener('click', async () => {
    if (!rawPdfBytes) return;
    try {
      const mode = (document.querySelector('input[name="layoutMode"]:checked') as HTMLInputElement)?.value as any || 'thermal4x6';

      const finalPageOrder: number[] = [];
      activeGroups.forEach((g) => {
        if (!excludedGroupIds.has(g.id)) {
          finalPageOrder.push(...g.pageIndices);
        }
      });

      const result = await cropPdfLabels(rawPdfBytes, {
        mode,
        margins: {
          topPercent: parseInt(sliderTop.value, 10),
          bottomPercent: parseInt(sliderBottom.value, 10),
          leftPercent: parseInt(sliderLeft.value, 10),
          rightPercent: parseInt(sliderRight.value, 10),
        },
        pageOrder: finalPageOrder.length > 0 ? finalPageOrder : undefined,
      });

      const blob = new Blob([result.pdfBytes], { type: 'application/pdf' });
      const blobUrl = URL.createObjectURL(blob);
      const iframe = document.createElement('iframe');
      iframe.style.display = 'none';
      iframe.src = blobUrl;
      document.body.appendChild(iframe);
      iframe.onload = () => {
        iframe.contentWindow?.print();
      };
    } catch (e: any) {
      alert('Unable to print directly: ' + e.message);
    }
  });

  // Reset button
  btnReset?.addEventListener('click', () => {
    rawPdfBytes = null;
    parsedMetadata = [];
    loadedAccounts = [];
    activeGroups = [];
    excludedGroupIds.clear();
    fileInput.value = '';
    if (addAccountInput) addAccountInput.value = '';
    accountsChipRow.style.display = 'none';
    mapGroupsContainer.innerHTML = '';
    workbenchActive.style.display = 'none';
    dropzone.style.display = 'block';

    const stepPill1 = document.getElementById('stepPill1');
    const stepPill2 = document.getElementById('stepPill2');
    const stepPill3 = document.getElementById('stepPill3');
    stepPill1?.classList.add('active');
    stepPill2?.classList.remove('active');
    stepPill3?.classList.remove('active');
  });
</script>
