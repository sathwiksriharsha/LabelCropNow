---
import type { ToolPreset } from '../config/site.js';
import BrandLogo from './BrandLogo.astro';

export interface Props {
  preset?: ToolPreset;
}

const { preset } = Astro.props;
const defaultCrop = preset?.defaultCrop || { topPercent: 0, bottomPercent: 50, leftPercent: 0, rightPercent: 0 };
const defaultMode = preset?.defaultMode || 'thermal4x6';
const sampleType = preset?.sampleType || 'meesho';

const isSpecificPreset = !!preset;
---

<div class="workbench-container card" id="workbench">
  <!-- Privacy & Status Header with 3-Step Tracker -->
  <div class="workbench-header">
    <div class="header-left">
      <div class="status-indicator">
        <span class="status-dot"></span>
        <span class="status-text font-mono">100% Client-Side RAM</span>
      </div>
      <span class="preset-name font-sans">{preset ? preset.name : 'Universal Shipping Label Cropper'}</span>
    </div>

    <!-- 3-Step Flow Indicators -->
    <div class="steps-progress-row font-sans">
      <div class="step-badge active" id="stepPill1">
        <span class="step-num">1</span>
        <span class="step-label">Choose file</span>
      </div>
      <span class="step-arrow">→</span>
      <div class="step-badge" id="stepPill2">
        <span class="step-num">2</span>
        <span class="step-label">Crop & Sort</span>
      </div>
      <span class="step-arrow">→</span>
      <div class="step-badge" id="stepPill3">
        <span class="step-num">3</span>
        <span class="step-label">Export Batch</span>
      </div>
    </div>

    <div class="header-right">
      <span class="badge badge-emerald font-mono">Zero Uploads • No Server Storage</span>
    </div>
  </div>

  <!-- Channel Banner (on Preset pages) OR Floating Capsule Switcher (on Homepage) -->
  {isSpecificPreset ? (
    <div class="active-channel-banner">
      <div class="active-channel-left">
        <div class="active-channel-logo-wrap">
          <BrandLogo brand={preset.shortName || preset.slug} size={30} />
        </div>
        <div class="active-channel-text">
          <div class="active-channel-badge font-mono">ACTIVE MARKETPLACE PRESET</div>
          <div class="active-channel-name font-sans">{preset.name}</div>
          <div class="active-channel-meta font-mono">
            <span>{preset.defaultMode === 'a4_4up' ? 'A4 4-Up Grid (2×2)' : '4×6" Thermal Roll'}</span>
            <span class="dot">•</span>
            <span>{preset.defaultCrop.bottomPercent}% Auto Crop</span>
            <span class="dot">•</span>
            <span>100% Vector Fidelity</span>
          </div>
        </div>
      </div>
      <div class="active-channel-right">
        <a href="/supported-marketplaces" class="btn-switch-preset font-mono">Change Channel Preset →</a>
      </div>
    </div>
  ) : (
    <div class="marketplace-switcher-wrap">
      <div class="marketplace-pill-bar" id="marketplacePillBar">
        <button type="button" class="mp-tab active" data-market="meesho">
          <BrandLogo brand="meesho" size={18} />
          <span class="mp-name">Meesho</span>
        </button>
        <button type="button" class="mp-tab" data-market="flipkart">
          <BrandLogo brand="flipkart" size={18} />
          <span class="mp-name">Flipkart</span>
        </button>
        <button type="button" class="mp-tab" data-market="amazon">
          <BrandLogo brand="amazon" size={18} />
          <span class="mp-name">Amazon</span>
        </button>
        <button type="button" class="mp-tab" data-market="tiktok">
          <BrandLogo brand="tiktok" size={18} />
          <span class="mp-name">TikTok Shop</span>
        </button>
        <button type="button" class="mp-tab" data-market="usps">
          <BrandLogo brand="usps" size={16} fallbackText="USPS" />
          <span class="mp-name">USPS / FBA</span>
        </button>
        <button type="button" class="mp-tab" data-market="shiprocket">
          <BrandLogo brand="shiprocket" size={16} fallbackText="SHIPROCKET" />
          <span class="mp-name">Shiprocket</span>
        </button>
      </div>
    </div>
  )}

  <!-- Dropzone Area -->
  <div class="dropzone" id="dropzone">
    <input type="file" id="fileInput" accept="application/pdf" multiple class="file-input" />
    <div class="dropzone-inner">
      <div class="dropzone-icon">
        <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="#059669" />
          <polyline points="14 2 14 8 20 8" stroke="#059669" />
          <line x1="12" y1="18" x2="12" y2="12" stroke="#0284c7" />
          <polyline points="9 15 12 12 15 15" stroke="#0284c7" />
        </svg>
      </div>
      <h3 class="dropzone-title font-sans" id="dropzoneTitle">
        {preset ? `Drop your ${preset.shortName} Shipping Label PDF here` : 'Drop your Shipping Label PDF here'}
      </h3>
      <p class="dropzone-subtitle font-sans">or click to browse your computer (Supports single or multi-account PDFs, processed in browser RAM)</p>

      <!-- Instant Sample Buttons -->
      <div class="sample-pills" id="samplePills">
        <span class="sample-label font-mono">Or test in 1-click with realistic sample orders:</span>
        <div class="sample-btns">
          {preset ? (
            <button type="button" class="btn btn-sample" id="btnDynamicSample" data-slug={preset.slug}>
              ⚡ Load Sample {preset.shortName} Label PDF
            </button>
          ) : (
            <>
              <button type="button" class="btn btn-sample" id="btnSampleMeesho" data-type="meesho">
                ⚡ Sample Meesho (6 Orders)
              </button>
              <button type="button" class="btn btn-sample" id="btnSampleFlipkart" data-type="flipkart">
                ⚡ Sample Flipkart Ekart
              </button>
              <button type="button" class="btn btn-sample" id="btnSampleTikTok" data-type="tiktok">
                ⚡ Sample TikTok Shop (4×6)
              </button>
              <button type="button" class="btn btn-sample" id="btnSampleFba" data-type="amazon_fba">
                ⚡ Sample US Letter (8.5×11")
              </button>
            </>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Loading State -->
  <div class="workbench-loading" id="workbenchLoading" style="display: none;">
    <div class="spinner"></div>
    <div class="loading-text" id="loadingText">Extracting SKUs & Courier Barcodes...</div>
  </div>

  <!-- Active Workbench Controls (shown when file is loaded) -->
  <div class="workbench-active" id="workbenchActive" style="display: none;">
    <!-- File Inspector Strip -->
    <div class="inspector-strip">
      <div class="file-meta">
        <span class="file-name" id="dispFileName">meesho_ready_to_ship.pdf</span>
        <span class="badge badge-blue" id="dispPageCount">6 Pages</span>
        <span class="badge badge-emerald" id="dispVectorBadge">100% Vector Fidelity</span>
      </div>
      <div class="courier-tags" id="dispCourierTags">
        <!-- Rendered dynamically: Valmo, Delhivery, etc. -->
      </div>
      <div class="multi-account-addon">
        <label for="addAccountInput" class="btn-add-account font-mono" title="Merge labels from another seller account or batch">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          + Add Account PDF
        </label>
        <input type="file" id="addAccountInput" accept="application/pdf" multiple style="display: none;" />
      </div>
    </div>

    <!-- Multi-Qty Alert Box (if detected) -->
    <div class="multi-qty-alert" id="multiQtyAlert" style="display: none;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
        <line x1="12" y1="9" x2="12" y2="13"/>
        <line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
      <div class="alert-content">
        <strong id="multiQtyTitle">Multi-Quantity Orders Detected!</strong>
        <span id="multiQtyDesc">2 orders contain multiple items. They will be highlighted to prevent warehouse under-shipping.</span>
      </div>
    </div>

    <!-- Controls Grid -->
    <div class="controls-grid">
      <!-- Left Column: Layout & Sorting Options -->
      <div class="controls-col">
        <div class="control-group">
          <label class="control-label">1. Output Layout Mode</label>
          <div class="layout-options">
            <label class="layout-radio">
              <input type="radio" name="layoutMode" value="thermal4x6" checked={defaultMode === 'thermal4x6'} />
              <div class="radio-card">
                <span class="radio-title">4×6" Thermal Roll</span>
                <span class="radio-desc">1 label per page (288×432 pt) for Rollo, Zebra, TVS</span>
              </div>
            </label>
            <label class="layout-radio">
              <input type="radio" name="layoutMode" value="a4_4up" checked={defaultMode === 'a4_4up'} />
              <div class="radio-card">
                <span class="radio-title">A4 4-Up Grid (2×2)</span>
                <span class="radio-desc">4 labels per A4 sheet (Saves 75% paper on laser/inkjet)</span>
              </div>
            </label>
            <label class="layout-radio">
              <input type="radio" name="layoutMode" value="letter_4up" checked={defaultMode === 'letter_4up'} />
              <div class="radio-card">
                <span class="radio-title">US Letter 4-Up</span>
                <span class="radio-desc">4 labels per 8.5×11" sheet with cut guides</span>
              </div>
            </label>
            <label class="layout-radio">
              <input type="radio" name="layoutMode" value="keep_invoice" checked={defaultMode === 'keep_invoice'} />
              <div class="radio-card">
                <span class="radio-title">Keep Invoice Attached</span>
                <span class="radio-desc">4×4 label top + mini invoice strip bottom</span>
              </div>
            </label>
          </div>
        </div>

        <div class="control-group">
          <label class="control-label">2. Warehouse Sorting & Packing Order</label>
          <div class="sort-options">
            <label class="sort-pill">
              <input type="radio" name="sortOption" value="original" checked />
              <span>Original Order</span>
            </label>
            <label class="sort-pill">
              <input type="radio" name="sortOption" value="sku" />
              <span>Sort by SKU (A→Z)</span>
            </label>
            <label class="sort-pill">
              <input type="radio" name="sortOption" value="courier" />
              <span>Sort by Courier Partner</span>
            </label>
            <label class="sort-pill">
              <input type="radio" name="sortOption" value="multi_first" />
              <span>Multi-Qty Orders First</span>
            </label>
          </div>
        </div>

        <div class="control-group">
          <label class="control-label">3. Thermal Enhancements</label>
          <div class="checkbox-options">
            <label class="checkbox-row">
              <input type="checkbox" id="chkStampMulti" checked />
              <span>Stamp <strong>[!] MULTI-QTY</strong> warning banner on parcel labels</span>
            </label>
            <label class="checkbox-row">
              <input type="checkbox" id="chkManifest" />
              <span>Append <strong>Courier Handover Manifest</strong> summary sheet</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Right Column: Crop Adjustment Sliders & Live Visual Preview -->
      <div class="preview-col">
        <label class="control-label">Visual Crop Bounding Box Adjustment</label>
        <div class="crop-sliders">
          <div class="slider-row">
            <span>Top Crop (Remove top):</span>
            <input type="range" id="sliderTop" min="0" max="80" value={defaultCrop.topPercent} />
            <span class="slider-val" id="valTop">{defaultCrop.topPercent}%</span>
          </div>
          <div class="slider-row">
            <span>Bottom Crop (Remove invoice):</span>
            <input type="range" id="sliderBottom" min="0" max="80" value={defaultCrop.bottomPercent} />
            <span class="slider-val" id="valBottom">{defaultCrop.bottomPercent}%</span>
          </div>
          <div class="slider-row">
            <span>Left Margin:</span>
            <input type="range" id="sliderLeft" min="0" max="40" value={defaultCrop.leftPercent} />
            <span class="slider-val" id="valLeft">{defaultCrop.leftPercent}%</span>
          </div>
          <div class="slider-row">
            <span>Right Margin:</span>
            <input type="range" id="sliderRight" min="0" max="40" value={defaultCrop.rightPercent} />
            <span class="slider-val" id="valRight">{defaultCrop.rightPercent}%</span>
          </div>
        </div>

        <!-- Visual Canvas Preview -->
        <div class="preview-canvas-wrapper">
          <div class="preview-badge">Page 1 Live Crop Overlay</div>
          <canvas id="previewCanvas" width="300" height="424" class="preview-canvas"></canvas>
        </div>
      </div>
    </div>

    <!-- 4. Interactive Dispatch & Order Preview Map (Manual Group Reordering, SKU & Courier Exclusion) -->
    <div class="preview-map-card" id="previewMapCard">
      <div class="map-card-header">
        <div class="map-title-row">
          <div class="map-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
              <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            </svg>
          </div>
          <div>
            <h4 class="map-title font-sans">Dispatch & Order Preview Map</h4>
            <p class="map-subtitle font-sans">
              Preview label groups before download. Click <strong>↑ / ↓</strong> to manually reorder pickup sequence, or uncheck to exclude couriers & SKUs from export.
            </p>
          </div>
        </div>
        <div class="map-stats-badge font-mono" id="mapStatsBadge">
          0 of 0 labels active
        </div>
      </div>

      <!-- Multiple Accounts Badge Row -->
      <div class="accounts-chip-row" id="accountsChipRow" style="display: none;"></div>

      <!-- Groups List with Reorder and Exclude Toggles -->
      <div class="map-groups-container" id="mapGroupsContainer">
        <!-- Rendered dynamically -->
      </div>
    </div>

    <!-- Action Bar -->
    <div class="action-bar">
      <button type="button" class="btn btn-primary" id="btnDownload">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Download Cropped PDF
      </button>

      <button type="button" class="btn btn-secondary" id="btnPrint">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 6 2 18 2 18 9"/>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
          <rect x="6" y="14" width="12" height="8"/>
        </svg>
        Print
      </button>

      <button type="button" class="btn btn-secondary" id="btnReset">
        Reset / Upload Another
      </button>
    </div>
  </div>
</div>

<style>
  .workbench-container {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    margin-bottom: 3rem;
  }

  .workbench-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .steps-progress-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .step-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: #f1f5f9;
    border: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: all 0.2s ease;
  }

  .step-badge.active {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  .step-badge.active .step-num {
    background: #ffffff;
    color: #0f172a;
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 9999px;
    background: #cbd5e1;
    color: #0f172a;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .step-arrow {
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: #059669;
    font-weight: 600;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
    display: inline-block;
  }

  .preset-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
  }

  /* Active Channel Banner for Dedicated Preset Pages */
  .active-channel-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .active-channel-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .active-channel-logo-wrap {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 5px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
  }

  .active-channel-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .active-channel-badge {
    font-size: 0.65rem;
    color: #2563eb;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .active-channel-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.25;
  }

  .active-channel-meta {
    font-size: 0.74rem;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.15rem;
  }

  .btn-switch-preset {
    font-size: 0.78rem;
    font-weight: 600;
    color: #2563eb;
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    transition: all 0.15s ease;
  }

  .btn-switch-preset:hover {
    background: #dbeafe;
    text-decoration: none;
  }

  /* Floating Marketplace Pill Switcher (Universal Workbench) */
  .marketplace-switcher-wrap {
    display: flex;
    justify-content: center;
    margin: 0.5rem 0 1.5rem;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
  }

  .marketplace-switcher-wrap::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }

  .marketplace-pill-bar {
    display: inline-flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 9999px;
    padding: 0.3rem;
    gap: 0.35rem;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05), 0 1px 3px rgba(15, 23, 42, 0.03);
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
  }

  .marketplace-pill-bar::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
    background: transparent !important;
  }

  .mp-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 1.15rem;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: #334155;
    font-size: 0.92rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    text-decoration: none;
    user-select: none;
    flex-shrink: 0;
  }

  .mp-tab:hover:not(.active) {
    background: #f8fafc;
    color: #0f172a;
  }

  .mp-tab.active {
    background: #0f172a;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.25);
    font-weight: 600;
  }

  .mp-svg-logo {
    width: 18px;
    height: 18px;
    object-fit: contain;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .mp-name {
    font-family: var(--font-sans);
    line-height: 1;
  }

  /* Dropzone */
  .dropzone {
    border: 2px dashed #cbd5e1;
    border-radius: 12px;
    padding: 3rem 1.5rem;
    text-align: center;
    background: #f8fafc;
    cursor: pointer;
    position: relative;
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent-emerald);
    background: #f0fdf4;
  }

  .file-input {
    position: absolute;
    inset: 0;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  .dropzone-icon {
    margin-bottom: 1rem;
  }

  .dropzone-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.35rem;
  }

  .dropzone-subtitle {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }

  .sample-pills {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border-subtle);
  }

  .sample-label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }

  .sample-btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
  }

