---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site.js';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  faq?: { q: string; a: string }[];
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonicalPath = Astro.url.pathname,
  faq = []
} = Astro.props;

// Ensure clean canonical URL with no double slashes or trailing dots
const cleanPath = canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`;
const canonicalUrl = `${siteConfig.url}${cleanPath}`;

// JSON-LD Schema
const schemaData: any[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    'name': siteConfig.name,
    'url': siteConfig.url,
    'description': description,
    'applicationCategory': 'BusinessApplication',
    'operatingSystem': 'All (Web Browser)',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD'
    },
    'featureList': [
      '100% Client-Side PDF vector cropping',
      'Meesho, Flipkart, and Amazon A4 to 4x6 thermal roll converter',
      'Automatic SKU grouping and Courier Partner sorting',
      'A4 and US Letter 4-up paper saver grid',
      'Zebra ZPL II offline thermal rendering',
      'Zero server upload privacy architecture'
    ]
  }
];

if (faq && faq.length > 0) {
  schemaData.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': faq.map((item) => ({
      '@type': 'Question',
      'name': item.q,
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': item.a
      }
    }))
  });
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="google-site-verification" content="ASKo6hp9grGmM68t7B89_Kp0PJ6j2ZOtGIwARRLtknQ" />

    <!-- Google Fonts: Editorial Serif (Newsreader), Clean Sans (Inter), Handwriting (Caveat), Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteConfig.url}/logo.png`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteConfig.url}/logo.png`} />

    <!-- Theme & Icons -->
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- JSON-LD -->
    {schemaData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <Navbar />
    <main class="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .main-content {
    flex: 1 0 auto;
  }
</style>
