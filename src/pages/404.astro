---
import BaseLayout from '../layouts/BaseLayout.astro';

Astro.response.status = 404;
---

<BaseLayout
  title="Page Not Found (404) — LabelCropNow"
  description="The shipping label tool or page you requested could not be found. Return to the LabelCropNow workbench to crop and sort your orders."
  canonicalPath="/404/"
>
  <div class="notfound-container container">
    <div class="notfound-card card">
      <div class="notfound-badge font-mono">ERROR 404 • ROUTE NOT FOUND</div>
      
      <div class="notfound-icon">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
      </div>

      <h1 class="notfound-title font-serif">We couldn't find that parcel route.</h1>
      
      <p class="notfound-desc font-sans">
        The URL you followed may have changed, expired, or been moved to a new canonical address. All client-side label tools and generators remain active on the primary channels below.
      </p>

      <div class="notfound-actions">
        <a href="/" class="btn btn-primary font-sans">
          <span>← Return to Home Workbench</span>
        </a>
        <a href="/supported-marketplaces/" class="btn btn-secondary font-sans">
          <span>View All Marketplaces</span>
        </a>
      </div>

      <div class="popular-tools-box">
        <h2 class="popular-title font-mono">POPULAR SHIPPING TOOLS</h2>
        <div class="popular-grid">
          <a href="/crop/meesho/" class="tool-chip">
            <span class="chip-name">Meesho Label Cropper</span>
            <span class="chip-arrow">→</span>
          </a>
          <a href="/crop/flipkart/" class="tool-chip">
            <span class="chip-name">Flipkart Ekart 4×6</span>
            <span class="chip-arrow">→</span>
          </a>
          <a href="/crop/amazon/" class="tool-chip">
            <span class="chip-name">Amazon Easy Ship</span>
            <span class="chip-arrow">→</span>
          </a>
          <a href="/a4-4-labels-per-page-converter/" class="tool-chip">
            <span class="chip-name">A4 4-Up Grid Builder</span>
            <span class="chip-arrow">→</span>
          </a>
          <a href="/sort-shipping-labels-by-sku/" class="tool-chip">
            <span class="chip-name">SKU & Courier Sorter</span>
            <span class="chip-arrow">→</span>
          </a>
          <a href="/low-shipping/" class="tool-chip">
            <span class="chip-name">Meesho Low-Shipping Tool</span>
            <span class="chip-arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound-container {
    padding: 4rem 1.5rem 6rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .notfound-card {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 3.5rem 2.5rem;
    text-align: center;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
  }

  .notfound-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #ef4444;
    background: #fef2f2;
    border: 1px solid #fecaca;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    letter-spacing: 0.06em;
    margin-bottom: 1.5rem;
  }

  .notfound-icon {
    margin-bottom: 1.5rem;
  }

  .notfound-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .notfound-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  .notfound-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .popular-tools-box {
    border-top: 1px dashed var(--border-subtle);
    padding-top: 2rem;
    text-align: left;
  }

  .popular-title {
    font-size: 0.78rem;
    color: var(--text-dim);
    letter-spacing: 0.06em;
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .popular-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.85rem;
  }

  .tool-chip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    background: #f8fafc;
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    text-decoration: none;
    color: var(--text-main);
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .tool-chip:hover {
    background: #eff6ff;
    border-color: #93c5fd;
    color: #2563eb;
    transform: translateY(-1px);
  }

  .chip-arrow {
    color: #94a3b8;
    transition: transform 0.15s ease;
  }

  .tool-chip:hover .chip-arrow {
    color: #2563eb;
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .notfound-card {
      padding: 2.5rem 1.25rem;
    }
    .notfound-title {
      font-size: 1.75rem;
    }
  }
</style>
