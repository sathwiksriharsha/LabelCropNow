---
import BaseLayout from '../layouts/BaseLayout.astro';

const barcodeFaq = [
  {
    q: 'Can physical barcode laser scanners read these barcodes?',
    a: 'Yes! Our barcodes are rendered with standard ISO-compliant bar/space ratios for CODE 128, EAN-13, UPC-A, and CODE 39. They scan instantly with handheld laser scanners, Zebra/Honeywell mobile computers, and smartphone camera apps.'
  },
  {
    q: 'How do I print barcode stickers on an A4 sheet?',
    a: 'Click "Print Sticker Label Sheet" and choose your sticker layout (e.g. 24-Up or 30-Up A4 sheets, or 4×6 thermal rolls). You can print directly to your laser printer or thermal sticker roll with zero margin clipping.'
  },
  {
    q: 'Which barcode format should I choose for Flipkart, Meesho, or Amazon?',
    a: 'For internal inventory, SKUs, and Flipkart/Meesho price tags, CODE 128 is the industry standard because it supports alphanumeric text, dashes, and numbers. For retail products sold in stores, use EAN-13 (13 digits). For Amazon FBA item labels, CODE 128 (FNSKU) is required.'
  },
  {
    q: 'Is this barcode generator free and private?',
    a: 'Yes, 100% free and runs offline in your browser RAM. Your SKUs, brand names, and MRP prices are never sent to any server.'
  }
];
---

<BaseLayout
  title="Free Barcode Generator with Price Tag & Thermal Sticker Sheet Print | LabelCropNow"
  description="Generate CODE128, EAN-13, UPC-A, CODE39 barcodes online for free. Customize bar width, height, product price tags, and print A4 & thermal sticker label sheets instantly."
  canonicalPath="/barcode-generator"
  faq={barcodeFaq}
>
  <div class="barcode-page container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <span class="current">Barcode Generator</span>
    </nav>

    <!-- Header -->
    <header class="page-header text-center">
      <div class="badge-row">
        <span class="badge badge-emerald">Retail & Warehouse Barcode Studio</span>
        <span class="badge badge-blue">ISO Standard Encoders</span>
        <span class="badge badge-purple">Sticker Sheet Print</span>
      </div>
      <h1 class="page-title font-serif">Free Barcode Generator with Price Tag & Sticker Sheet Print</h1>
      <p class="page-subtitle font-sans">
        Generate Code 128, EAN-13, UPC-A, and Code 39 barcodes for Flipkart, Meesho, Amazon FBA, and retail tags with custom MRP prices, batch codes, and printable sticker sheets.
      </p>
    </header>

    <!-- Quick Preset Buttons -->
    <div class="presets-bar">
      <span class="presets-label font-mono">QUICK PRESETS:</span>
      <button type="button" class="preset-btn active" data-preset="meesho">Flipkart / Meesho Price Tag</button>
      <button type="button" class="preset-btn" data-preset="amazon">Amazon FBA FNSKU</button>
      <button type="button" class="preset-btn" data-preset="mrp">Retail MRP Tag</button>
      <button type="button" class="preset-btn" data-preset="bin">Warehouse Bin Location</button>
    </div>

    <!-- Main Generator Grid -->
    <div class="barcode-layout-grid">
      <!-- Left Column: Controls & Inputs -->
      <div class="card bc-controls-card">
        <h2 class="card-section-title font-sans">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h7"/></svg>
          Barcode Data & Tag Customization
        </h2>

        <div class="bc-form">
          <!-- Format Selection -->
          <div class="form-group">
            <label for="bcFormat" class="form-label font-sans">Barcode Symbology / Format</label>
            <select id="bcFormat" class="bc-input font-sans">
              <option value="CODE128" selected>CODE 128 (Universal E-commerce & SKU)</option>
              <option value="EAN13">EAN-13 (13 Digits Global Retail / GS1)</option>
              <option value="UPCA">UPC-A (12 Digits North America)</option>
              <option value="CODE39">CODE 39 (Alphanumeric Industrial)</option>
            </select>
          </div>

          <!-- SKU Data -->
          <div class="form-group">
            <label for="inputText" class="form-label font-sans">
              <span>Barcode Value / SKU Code *</span>
              <span class="hint font-mono">Alphanumeric</span>
            </label>
            <input type="text" id="inputText" class="bc-input font-mono" value="SKU-8849201" placeholder="e.g. SKU-8849201" />
          </div>

          <!-- Brand / Store Name -->
          <div class="form-group">
            <label for="inputBrandName" class="form-label font-sans">Brand / Store Name</label>
            <input type="text" id="inputBrandName" class="bc-input font-sans" value="ROYAL FASHION" placeholder="e.g. Royal Fashion" />
          </div>

          <!-- Product Title -->
          <div class="form-group">
            <label for="inputProductTitle" class="form-label font-sans">Product Title</label>
            <input type="text" id="inputProductTitle" class="bc-input font-sans" value="Cotton Men T-Shirt" placeholder="e.g. Cotton Men T-Shirt" />
          </div>

          <!-- Variation -->
          <div class="form-group">
            <label for="inputVariation" class="form-label font-sans">Variant / Size / Color</label>
            <input type="text" id="inputVariation" class="bc-input font-sans" value="Size: L | Color: Blue" placeholder="e.g. Size: L | Color: Blue" />
          </div>

          <!-- MRP Price -->
          <div class="form-group">
            <label for="inputPriceTag" class="form-label font-sans">MRP / Price (₹)</label>
            <div class="input-wrap">
              <span class="prefix">₹</span>
              <input type="text" id="inputPriceTag" class="bc-input font-mono with-prefix" value="799" placeholder="799" />
            </div>
          </div>

          <!-- Sliders: Height & Width -->
          <div class="sliders-row">
            <div class="form-group">
              <label for="barHeight" class="form-label font-sans">Bar Height (<span id="valHeight">70</span>px)</label>
              <input type="range" id="barHeight" min="40" max="120" value="70" class="bc-range" />
            </div>
            <div class="form-group">
              <label for="barWidth" class="form-label font-sans">Bar Width (<span id="valWidth">2</span>px)</label>
              <input type="range" id="barWidth" min="1" max="4" value="2" class="bc-range" />
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Live Preview & Print -->
      <div class="bc-preview-column">
        <!-- Live Tag Preview Card -->
        <div class="card bc-tag-card">
          <div class="tag-header">
            <span class="tag-live-badge font-mono">LIVE PREVIEW</span>
            <span class="tag-dimensions font-mono">50×35 mm Sticker</span>
          </div>

          <div class="tag-sticker-body" id="tagStickerPreview">
            <div class="tag-brand-row font-sans" id="previewBrand">ROYAL FASHION</div>
            <div class="tag-title-row font-sans" id="previewTitle">Cotton Men T-Shirt</div>
            <div class="tag-variant-row font-mono" id="previewVariant">Size: L | Color: Blue</div>

            <!-- Canvas Barcode Container -->
            <div class="barcode-canvas-container">
              <canvas id="bcCanvas"></canvas>
            </div>

            <div class="tag-footer-row">
              <span class="tag-sku font-mono" id="previewSku">SKU-8849201</span>
              <span class="tag-price font-sans" id="previewPrice">MRP: ₹799</span>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="bc-actions-grid">
            <button type="button" class="btn btn-primary" id="btnDownloadPng">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span>Download PNG</span>
            </button>
            <button type="button" class="btn btn-secondary" id="btnDownloadSvg">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
              <span>Download SVG</span>
            </button>
            <button type="button" class="btn btn-secondary" id="btnCopyClipboard">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span>Copy Image</span>
            </button>
            <button type="button" class="btn btn-print" id="btnPrintSheet">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
              <span>Print Sticker Sheet</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Hidden Printable Sheet Container (Used for window.print) -->
    <div id="printableSheet" class="printable-sheet"></div>

    <!-- Educational Section -->
    <section class="guide-section card">
      <h2 class="guide-title font-serif">Barcode Symbology Guide for Indian & Global Sellers</h2>
      <div class="guide-grid">
        <div class="guide-card">
          <h3 class="guide-h3 font-sans">CODE 128 (Best for E-Commerce)</h3>
          <p class="guide-p font-sans">High-density alphanumeric format used for Flipkart item barcodes, Meesho SKUs, Amazon FNSKUs, and courier AWB numbers. Highly reliable and scanner friendly.</p>
        </div>
        <div class="guide-card">
          <h3 class="guide-h3 font-sans">EAN-13 (Standard Retail)</h3>
          <p class="guide-p font-sans">13-digit standard for packaged goods sold in supermarkets, retail chains, and international marketplaces. Includes automatic modulo-10 checksum validation.</p>
        </div>
        <div class="guide-card">
          <h3 class="guide-h3 font-sans">Sticker Sheet Layouts</h3>
          <p class="guide-p font-sans">Print 24 to 30 price tags per standard A4 sticker sheet or single continuous rolls on 4×6 thermal printers like Zebra, TVS, TSC, and Rollo with zero waste.</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Pure Client-side Barcode Encoders
  const Encoders = {
    CODE128: function(text: string) {
      const patterns = [
        "212222","222122","222221","121223","121322","131222","122213","122312","132212","221213",
        "221312","231212","112232","122132","122231","113222","123122","123221","223211","221132",
        "221231","213212","223112","312131","311222","321122","321221","312212","322112","322211",
        "212123","212321","232121","111323","131123","131321","112313","132113","132311","211313",
        "231113","231311","112133","112331","132131","113123","113321","133121","313121","211331",
        "231131","213113","213311","213131","311123","311321","331121","312113","312311","332111",
        "314111","221411","431111","111224","111422","121124","121421","141122","141221","112214",
        "112412","122114","122411","142112","142211","241211","221114","413111","241112","134111",
        "111242","121142","121241","114212","124112","124211","411212","421112","421211","212141",
        "214121","412121","111143","111341","131141","114113","114311","411113","411311","113141",
        "114131","311141","411131","211412","211214","211232","2331112"
      ];
      let checksum = 104;
      const codes = [104];
      for (let i = 0; i < text.length; i++) {
        let code = text.charCodeAt(i) - 32;
        if (code < 0 || code > 95) code = 0;
        codes.push(code);
        checksum += code * (i + 1);
      }
      codes.push(checksum % 103);
      codes.push(106); // Stop code
      let bars = "";
      codes.forEach(c => { bars += patterns[c] || patterns[0]; });
      return { bars, text };
    },

    EAN13: function(rawText: string) {
      let t = rawText.replace(/\D/g, "");
      if (t.length < 12) t = (t + "000000000000").slice(0, 12);
      if (t.length > 13) t = t.slice(0, 13);
      if (t.length === 12) {
        let sum = 0;
        for (let i = 0; i < 12; i++) sum += parseInt(t[i]) * (i % 2 === 0 ? 1 : 3);
        t += (10 - (sum % 10)) % 10;
      }
      const L = ["3211","2221","2122","1411","1132","1231","1114","1312","1213","3112"];
      const G = ["1123","1222","2212","1141","2311","1321","4111","2131","3121","2113"];
      const R = ["3211","2221","2122","1411","1132","1231","1114","1312","1213","3112"];
      const parity = ["LLLLLL","LLGLGG","LLGGLG","LLGGGL","LGLLGG","LGGLLG","LGGGLL","LGLGLG","LGLGGL","LGGLGL"][parseInt(t[0])];
      let bars = "111"; // start guard
      for (let i = 1; i <= 6; i++) {
        const d = parseInt(t[i]);
        bars += parity[i - 1] === 'L' ? L[d] : G[d];
      }
      bars += "11111"; // center guard
      for (let i = 7; i <= 12; i++) {
        bars += R[parseInt(t[i])];
      }
      bars += "111"; // end guard
      return { bars, text: t };
    },

    UPCA: function(rawText: string) {
      let t = rawText.replace(/\D/g, "");
      if (t.length < 11) t = (t + "00000000000").slice(0, 11);
      if (t.length > 12) t = t.slice(0, 12);
      if (t.length === 11) {
        let sum = 0;
        for (let i = 0; i < 11; i++) sum += parseInt(t[i]) * (i % 2 === 0 ? 3 : 1);
        t += (10 - (sum % 10)) % 10;
      }
      return Encoders.EAN13("0" + t);
    },

    CODE39: function(text: string) {
      let t = text.toUpperCase().replace(/[^0-9A-Z\-\.\ \$\/\+\%]/g, "") || "123456";
      const table: Record<string, string> = {
        "0":"111221211","1":"211211112","2":"112211112","3":"212211111","4":"111221112",
        "5":"211221111","6":"112221111","7":"111211212","8":"211211211","9":"112211211",
        "A":"211112112","B":"112112112","C":"212112111","D":"111122112","E":"211122111",
        "F":"112122111","G":"111112212","H":"211112211","I":"112112211","J":"111122211",
        "K":"211111122","L":"112111122","M":"212111121","N":"111121122","O":"211121121",
        "P":"112121121","Q":"111111222","R":"211111221","S":"112111221","T":"111121221",
        "U":"221111112","V":"122111112","W":"222111111","X":"121121112","Y":"221121111",
        "Z":"122121111","-":"121111212",".":"221111211"," ":"122111211","$":"121212111",
        "/":"121211121","+":"121112121","%":"111212121","*":"121121211"
      };
      let bars = table["*"];
      for (let i = 0; i < t.length; i++) {
        bars += "1" + (table[t[i]] || table["-"]);
      }
      bars += "1" + table["*"];
      return { bars, text: t };
    }
  };

  const canvas = document.getElementById('bcCanvas') as HTMLCanvasElement;
  const inputFormat = document.getElementById('bcFormat') as HTMLSelectElement;
  const inputText = document.getElementById('inputText') as HTMLInputElement;
  const inputBrand = document.getElementById('inputBrandName') as HTMLInputElement;
  const inputTitle = document.getElementById('inputProductTitle') as HTMLInputElement;
  const inputVariant = document.getElementById('inputVariation') as HTMLInputElement;
  const inputPrice = document.getElementById('inputPriceTag') as HTMLInputElement;
  const inputBarHeight = document.getElementById('barHeight') as HTMLInputElement;
  const inputBarWidth = document.getElementById('barWidth') as HTMLInputElement;

  function renderBarcode() {
    const format = inputFormat.value as keyof typeof Encoders;
    const text = inputText.value.trim() || 'SKU-8849201';
    const barW = parseInt(inputBarWidth.value) || 2;
    const barH = parseInt(inputBarHeight.value) || 70;

    document.getElementById('valHeight')!.innerText = barH.toString();
    document.getElementById('valWidth')!.innerText = barW.toString();

    // Update Text Previews
    document.getElementById('previewBrand')!.innerText = inputBrand.value || 'BRAND NAME';
    document.getElementById('previewTitle')!.innerText = inputTitle.value || 'Product Title';
    document.getElementById('previewVariant')!.innerText = inputVariant.value || '';
    document.getElementById('previewSku')!.innerText = text;
    document.getElementById('previewPrice')!.innerText = inputPrice.value ? `MRP: ₹${inputPrice.value}` : '';

    const encoder = Encoders[format] || Encoders.CODE128;
    const encoded = encoder(text);
    const bars = encoded.bars;

    // Calculate canvas size
    const totalModules = bars.split('').reduce((acc, c) => acc + parseInt(c), 0);
    const quietZone = 10 * barW;
    const canvasW = totalModules * barW + quietZone * 2;
    const canvasH = barH + 24;

    canvas.width = canvasW;
    canvas.height = canvasH;

    const ctx = canvas.getContext('2d')!;
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, canvasW, canvasH);

    // Draw bars
    let x = quietZone;
    let isBar = true;
    for (let i = 0; i < bars.length; i++) {
      const moduleWidth = parseInt(bars[i]) * barW;
      if (isBar) {
        ctx.fillStyle = '#000000';
        ctx.fillRect(x, 4, moduleWidth, barH);
      }
      x += moduleWidth;
      isBar = !isBar;
    }

    // Draw human readable text below barcode
    ctx.fillStyle = '#0f172a';
    ctx.font = '600 13px "Inter", monospace';
    ctx.textAlign = 'center';
    ctx.fillText(encoded.text, canvasW / 2, barH + 18);
  }

  // Event Listeners
  [inputFormat, inputText, inputBrand, inputTitle, inputVariant, inputPrice, inputBarHeight, inputBarWidth].forEach(el => {
    el?.addEventListener('input', renderBarcode);
    el?.addEventListener('change', renderBarcode);
  });

  // Preset Buttons
  const presetButtons = document.querySelectorAll('.preset-btn');
  presetButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      presetButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const p = btn.getAttribute('data-preset');
      if (p === 'meesho') {
        inputFormat.value = 'CODE128';
        inputText.value = 'MEE-7729-KURTI';
        inputBrand.value = 'FASHION HUB';
        inputTitle.value = 'Embroidered Anarkali Kurti';
        inputVariant.value = 'Size: XL | Color: Maroon';
        inputPrice.value = '849';
      } else if (p === 'amazon') {
        inputFormat.value = 'CODE128';
        inputText.value = 'X0039A8F1L';
        inputBrand.value = 'AMAZON FBA';
        inputTitle.value = 'Wireless Bluetooth Earbuds';
        inputVariant.value = 'Condition: New | FNSKU';
        inputPrice.value = '1499';
      } else if (p === 'mrp') {
        inputFormat.value = 'EAN13';
        inputText.value = '890103082914';
        inputBrand.value = 'ORGANIC HERBS';
        inputTitle.value = 'Pure Aloe Vera Gel 200ml';
        inputVariant.value = 'Net Qty: 200g | Mfg: 10/26';
        inputPrice.value = '299';
      } else if (p === 'bin') {
        inputFormat.value = 'CODE39';
        inputText.value = 'BIN-A3-R12';
        inputBrand.value = 'WAREHOUSE ZONE A';
        inputTitle.value = 'RACK 12 - TIER 3';
        inputVariant.value = 'Aisle: East-04';
        inputPrice.value = '';
      }
      renderBarcode();
    });
  });

  // Download PNG
  document.getElementById('btnDownloadPng')?.addEventListener('click', () => {
    const a = document.createElement('a');
    a.href = canvas.toDataURL('image/png');
    a.download = `barcode_${inputText.value || 'label'}.png`;
    a.click();
  });

  // Download SVG
  document.getElementById('btnDownloadSvg')?.addEventListener('click', () => {
    const format = inputFormat.value as keyof typeof Encoders;
    const text = inputText.value.trim() || 'SKU-8849201';
    const barW = parseInt(inputBarWidth.value) || 2;
    const barH = parseInt(inputBarHeight.value) || 70;
    const encoder = Encoders[format] || Encoders.CODE128;
    const bars = encoder(text).bars;

    const totalModules = bars.split('').reduce((acc, c) => acc + parseInt(c), 0);
    const quietZone = 10 * barW;
    const totalW = totalModules * barW + quietZone * 2;
    const totalH = barH + 24;

    let svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${totalW}" height="${totalH}" viewBox="0 0 ${totalW} ${totalH}">\n`;
    svg += `<rect width="${totalW}" height="${totalH}" fill="#ffffff"/>\n`;

    let x = quietZone;
    let isBar = true;
    for (let i = 0; i < bars.length; i++) {
      const moduleWidth = parseInt(bars[i]) * barW;
      if (isBar) {
        svg += `<rect x="${x}" y="4" width="${moduleWidth}" height="${barH}" fill="#000000"/>\n`;
      }
      x += moduleWidth;
      isBar = !isBar;
    }
    svg += `<text x="${totalW / 2}" y="${barH + 18}" font-family="monospace" font-size="13" font-weight="600" text-anchor="middle" fill="#0f172a">${text}</text>\n`;
    svg += `</svg>`;

    const blob = new Blob([svg], { type: 'image/svg+xml' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `barcode_${text}.svg`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // Copy to Clipboard
  document.getElementById('btnCopyClipboard')?.addEventListener('click', () => {
    canvas.toBlob(blob => {
      if (!blob) return;
      try {
        const item = new ClipboardItem({ 'image/png': blob });
        navigator.clipboard.write([item]).then(() => {
          alert('Barcode image copied to clipboard! You can paste it into Word, Canva, or Illustrator.');
        });
      } catch (err) {
        alert('Clipboard image copy not supported in this browser. Please use Download PNG.');
      }
    });
  });

  // Print Sticker Sheet
  document.getElementById('btnPrintSheet')?.addEventListener('click', () => {
    const printable = document.getElementById('printableSheet')!;
    const previewEl = document.getElementById('tagStickerPreview')!;
    printable.innerHTML = '';

    // Generate 24 copies on A4 grid
    for (let i = 0; i < 24; i++) {
      const clone = previewEl.cloneNode(true) as HTMLElement;
      // replace canvas with image data
      const oldCanvas = clone.querySelector('canvas');
      if (oldCanvas) {
        const img = document.createElement('img');
        img.src = canvas.toDataURL('image/png');
        img.style.maxWidth = '100%';
        img.style.height = 'auto';
        oldCanvas.parentNode?.replaceChild(img, oldCanvas);
      }
      printable.appendChild(clone);
    }

    window.print();
  });

  // Initialize on load
  renderBarcode();
</script>

<style>
  .barcode-page {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--primary);
  }
  .page-header {
    margin-bottom: 2rem;
  }
  .page-title {
    font-size: 2.2rem;
    color: var(--text-main);
    margin: 0.75rem 0 0.5rem;
  }
  .page-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
