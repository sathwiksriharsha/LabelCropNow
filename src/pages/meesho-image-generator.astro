---
import BaseLayout from '../layouts/BaseLayout.astro';

const imageFaq = [
  {
    q: 'How does adding a border help lower Meesho shipping charges?',
    a: 'Meesho AI catalog scanner and weight detection algorithms evaluate product image presentation and aspect ratios. Adding 15% to 35% margin padding and high-contrast frames helps catalog images meet Meesho automated dimensional guidelines and reduces buyer return rates due to accurate product focus.'
  },
  {
    q: 'What is the best aspect ratio for Meesho catalog images?',
    a: 'Meesho recommends 1:1 (square, e.g. 1000×1000 px) or 3:4 (portrait, e.g. 900×1200 px). Our tool generates variations in both aspect ratios with promotional corner badges.'
  },
  {
    q: 'Are my product photos uploaded to any server?',
    a: 'No! All 16 variations are rendered directly in your web browser using HTML5 Canvas. Your photos never leave your computer.'
  },
  {
    q: 'Can I download all 16 variations at once?',
    a: 'Yes, click "Download All 16 Variations (.ZIP)" to download a consolidated zip archive containing all square and portrait options ready to upload to Meesho Supplier Panel.'
  }
];
---

<BaseLayout
  title="Meesho Low-Shipping Catalog Image & Border Generator (Free 16 Variations)"
  description="Generate 16 Meesho catalog image variations with custom border padding (15%-35%), colorful frames, and promotional badges (Best Seller, Fast Dispatch) to test for lowest shipping rates. 100% client-side."
  canonicalPath="/meesho-image-generator"
  faq={imageFaq}
>
  <div class="generator-page container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <span class="current">Meesho Image Generator</span>
    </nav>

    <!-- Page Header -->
    <header class="page-header text-center">
      <div class="badge-row">
        <span class="badge badge-emerald">Meesho Supplier Optimization</span>
        <span class="badge badge-blue">16 Instant Variations</span>
        <span class="badge badge-purple">1-Click ZIP Download</span>
      </div>
      <h1 class="page-title font-serif">Meesho Low-Shipping Catalog Image Generator</h1>
      <p class="page-subtitle font-sans">
        Upload 1 product photo to generate 16 high-conversion catalog variations with optimized borders (15%–35%), solid/pastel frames, and promotional badges to test for the lowest shipping slab on Meesho.
      </p>
    </header>

    <!-- Generator Workbench Card -->
    <div class="generator-card card">
      <!-- Dropzone -->
      <div class="image-dropzone" id="imageDropzone">
        <input type="file" id="imageInput" accept="image/*" class="sr-only" />
        <div class="dropzone-inner">
          <div class="dropzone-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.8">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
          </div>
          <h2 class="dropzone-title font-sans">Drop your product photo here</h2>
          <p class="dropzone-desc font-sans">PNG, JPG, or WEBP (Apparel, footwear, jewelry, home decor)</p>

          <div class="dropzone-buttons">
            <button type="button" class="btn btn-primary" id="btnBrowseImage">
              <span>Select Product Image</span>
            </button>
            <button type="button" class="btn btn-secondary" id="btnLoadSampleImage">
              <span>✨ Load Sample Product Photo</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Loading State -->
      <div class="loading-state" id="loadingState" style="display: none;">
        <div class="spinner"></div>
        <p class="loading-text font-sans">Generating 16 high-resolution catalog variations on HTML5 Canvas...</p>
      </div>

      <!-- Results Grid Area -->
      <div class="results-area" id="resultsArea" style="display: none;">
        <div class="results-top-bar">
          <div>
            <h2 class="results-title font-sans">16 Generated Catalog Variations</h2>
            <p class="results-sub font-sans">Optimized for Meesho Supplier Panel catalog listing</p>
          </div>
          <button type="button" class="btn btn-primary btn-zip" id="btnDownloadZip">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>Download All 16 as .ZIP</span>
          </button>
        </div>

        <div class="variations-grid" id="variationsGrid">
          <!-- Populated dynamically via JS -->
        </div>
      </div>
    </div>

    <!-- Optimization Guide -->
    <section class="guide-section card">
      <h2 class="guide-title font-serif">Why Meesho Low-Shipping Borders Work</h2>
      <div class="guide-grid">
        <div class="guide-col">
          <h3 class="guide-h3">1. Dimensional Image Slab</h3>
          <p class="guide-p">Meesho automated image moderation algorithms penalize tight, zoomed-in photos with higher return rate flags. Adding 15%–35% clean margin frame helps keep the product centered and clear.</p>
        </div>
        <div class="guide-col">
          <h3 class="guide-h3">2. High-Contrast Attention Badges</h3>
          <p class="guide-p">Variations include "Best Seller", "Fast Dispatch", and "Combo Offer" corner badges. These badges dramatically increase click-through rate (CTR) in search results.</p>
        </div>
        <div class="guide-col">
          <h3 class="guide-h3">3. Square & Portrait Compliance</h3>
          <p class="guide-p">Generates exact 1:1 (1000×1000px) and 3:4 (900×1200px) formats ready to upload without Meesho crop-box distortion or stretched aspect ratios.</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import {
    generate16CatalogVariations,
    generateSampleProductImage,
    downloadCatalogVariationsZip,
    type CatalogVariation
  } from '../utils/catalogImageEngine.js';

  let currentVariations: CatalogVariation[] = [];

  const dropzone = document.getElementById('imageDropzone');
  const fileInput = document.getElementById('imageInput') as HTMLInputElement | null;
  const btnBrowse = document.getElementById('btnBrowseImage');
  const btnSample = document.getElementById('btnLoadSampleImage');
  const loadingState = document.getElementById('loadingState');
  const resultsArea = document.getElementById('resultsArea');
  const variationsGrid = document.getElementById('variationsGrid');
  const btnZip = document.getElementById('btnDownloadZip');

  btnBrowse?.addEventListener('click', () => fileInput?.click());

  fileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) processFile(file);
  });

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('drag-over');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('drag-over');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('drag-over');
    const file = e.dataTransfer?.files?.[0];
    if (file && file.type.startsWith('image/')) {
      processFile(file);
    }
  });

  btnSample?.addEventListener('click', () => {
    const sampleDataUrl = generateSampleProductImage();
    processDataUrl(sampleDataUrl);
  });

  function processFile(file: File) {
    const reader = new FileReader();
    reader.onload = (e) => {
      const dataUrl = e.target?.result as string;
      if (dataUrl) processDataUrl(dataUrl);
    };
    reader.readAsDataURL(file);
  }

  async function processDataUrl(dataUrl: string) {
    if (!loadingState || !resultsArea || !variationsGrid) return;
    loadingState.style.display = 'flex';
    resultsArea.style.display = 'none';

    try {
      currentVariations = await generate16CatalogVariations(dataUrl);
      renderVariations(currentVariations);
      loadingState.style.display = 'none';
      resultsArea.style.display = 'block';
      resultsArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      alert('Error generating variations: ' + err);
      loadingState.style.display = 'none';
    }
  }

  function renderVariations(variations: CatalogVariation[]) {
    if (!variationsGrid) return;
    variationsGrid.innerHTML = '';

    variations.forEach((v) => {
      const card = document.createElement('div');
      card.className = 'variation-card card';

      card.innerHTML = `
        <div class="var-img-wrap">
          <img src="${v.dataUrl}" alt="${v.name}" class="var-img" loading="lazy" />
          <span class="var-badge-tag">${v.aspectRatio} • ${v.paddingPercent}% PAD</span>
        </div>
        <div class="var-info">
          <h4 class="var-name font-sans">${v.name}</h4>
          <div class="var-specs font-mono">Badge: ${v.badgeText}</div>
          <a href="${v.dataUrl}" download="${v.filename}" class="btn btn-secondary btn-sm w-full text-center">
            Download PNG
          </a>
        </div>
      `;

      variationsGrid.appendChild(card);
    });
  }

  btnZip?.addEventListener('click', async () => {
    if (!currentVariations.length) return;
    btnZip.setAttribute('disabled', 'true');
    const origText = btnZip.innerHTML;
    btnZip.innerHTML = '<span>Compressing ZIP...</span>';

    try {
      await downloadCatalogVariationsZip(currentVariations);
    } catch (e) {
      alert('Failed to generate ZIP: ' + e);
    } finally {
      btnZip.removeAttribute('disabled');
      btnZip.innerHTML = origText;
    }
  });
</script>

<style>
  .generator-page {
    padding: 2.5rem 1.5rem 5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 2rem;
    font-family: var(--font-mono);
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .page-header {
    max-width: 840px;
    margin: 0 auto 3rem;
  }

  .badge-row {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .page-title {
    font-size: 2.85rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin-bottom: 1rem;
  }

  .page-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .generator-card {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 2.5rem;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
    margin-bottom: 4rem;
  }

  .image-dropzone {
    border: 2px dashed #cbd5e1;
    border-radius: 16px;
    padding: 3.5rem 2rem;
    text-align: center;
    background: #f8fafc;
    transition: all 0.2s ease;
  }

  .image-dropzone.drag-over {
    border-color: #2563eb;
    background: #eff6ff;
  }

  .dropzone-icon {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .dropzone-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.5rem;
  }

  .dropzone-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .dropzone-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .loading-state {
    padding: 4rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .spinner {
    width: 44px;
    height: 44px;
    border: 4px solid #e2e8f0;
    border-top-color: #2563eb;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .loading-text {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .results-area {
    margin-top: 2rem;
  }

  .results-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .results-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .results-sub {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .btn-zip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
  }

  .variations-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .variation-card {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .variation-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
  }

  .var-img-wrap {
    position: relative;
    background: #f8fafc;
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .var-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    display: block;
  }

  .var-badge-tag {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(15, 23, 42, 0.85);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .var-info {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .var-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.35;
  }

  .var-specs {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .btn-sm {
    padding: 0.45rem 0.75rem;
    font-size: 0.82rem;
    margin-top: auto;
  }

  .w-full {
    width: 100%;
  }

  .guide-section {
    padding: 2.5rem;
    background: #f8fafc;
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
  }

  .guide-title {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 2rem;
    text-align: center;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .guide-h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.5rem;
  }

  .guide-p {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  @media (max-width: 1024px) {
    .variations-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .guide-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .generator-card {
      padding: 1.25rem 0.85rem;
    }

    .image-dropzone {
      padding: 2.25rem 1rem;
    }

    .variations-grid {
      grid-template-columns: 1fr;
    }

    .page-title {
      font-size: 2rem;
    }

    .dropzone-buttons {
      flex-direction: column;
      width: 100%;
    }

    .dropzone-buttons .btn {
      width: 100%;
    }

    .results-top-bar {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
      gap: 1rem;
    }

    .btn-zip {
      width: 100%;
      justify-content: center;
    }
  }
</style>
