    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .action-buttons-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.8rem 1.75rem;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    border: none;
    transition: all 0.15s ease;
  }
  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .btn-send-wa {
    background: #25d366;
    color: #ffffff;
    flex: 1;
    min-width: 220px;
  }
  .btn-send-wa:hover:not(:disabled) {
    background: #128c7e;
  }
  .btn-secondary {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #1e293b;
  }
  .btn-secondary:hover:not(:disabled) {
    background: #f1f5f9;
  }
  .recent-chats-card {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .recent-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }
  .recent-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-main);
  }
  .btn-clear-history {
    background: none;
    border: none;
    color: #ef4444;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
  }
  .recent-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  :global(.recent-chip) {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  :global(.recent-chip:hover) {
    background: #eff6ff;
    border-color: #2563eb;
    color: #2563eb;
  }
  .guide-section {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 2rem;
  }
  .guide-title {
    font-size: 1.4rem;
    color: var(--text-main);
    margin-bottom: 1.5rem;
    text-align: center;
  }
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 768px) {
    .guide-grid { grid-template-columns: 1fr; }
  }
  .guide-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.25rem;
  }
  .guide-h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.4rem;
  }
  .guide-p {
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.45;
  }
</style>
