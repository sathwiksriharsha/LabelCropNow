---
import BaseLayout from '../layouts/BaseLayout.astro';
import LabelWorkbench from '../components/LabelWorkbench.astro';
import ZplWorkbench from '../components/ZplWorkbench.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { siteConfig } from '../config/site.js';

const homeFaq = [
  {
    q: 'How does LabelCropNow protect seller privacy and customer data?',
    a: 'LabelCropNow is engineered with a 100% client-side architecture. When you drop a PDF into the tool, all parsing, vector cropping, SKU sorting, and page re-arrangements happen directly inside your web browser’s memory (RAM). No files, customer names, addresses, phone numbers, or GSTINs are ever transmitted to any server.'
  },
  {
    q: 'Why do my thermal barcodes stay sharp with LabelCropNow while other online tools make them blurry?',
    a: 'Most free online converters convert your PDF pages into low-resolution raster images (JPG or PNG) and re-pack them into a new PDF. This blurs delicate 1D/2D barcodes and causes scanner rejection at courier hubs. LabelCropNow directly mutates vector CropBoxes and MediaBoxes using WebAssembly, ensuring 100% lossless line-art clarity for high-speed optical scanning.'
  },
  {
    q: 'Can I print 4 Meesho or Flipkart labels on a single A4 sheet to save paper?',
    a: 'Yes! Select the "A4 4-Up Grid" mode. LabelCropNow crops out the bottom tax invoice from each order and arranges 4 shipping labels onto a single A4 page in a 2x2 grid with cutting lines, saving up to 75% paper on standard inkjet or laser printers.'
  },
  {
    q: 'How does the automatic SKU and Courier sorting work?',
    a: 'Before cropping, our client-side text extractor analyzes each dispatch slip for Courier Partners (Valmo, Delhivery, Shadowfax, Ekart, ATS, etc.), product SKU codes, and quantities. You can re-order hundreds of labels alphabetically by SKU or grouped by courier partner in one click.'
  },
  {
    q: 'Does LabelCropNow work offline?',
    a: 'Yes! Once loaded in your browser, LabelCropNow can process PDF files and ZPL code completely offline without an active internet connection.'
  },
  {
    q: 'Which printers are supported?',
    a: 'All standard 4×6" thermal label printers (Zebra, Rollo, TSC, Brother, MUNBYN, Xprinter, TVS) and standard A4/Letter laser or inkjet printers (HP, Canon, Epson, Brother) are 100% supported.'
  }
];

// Curated Marketplace Presets with Real Official SVG Logos (Matching User Image 2)
const PRESET_HIGHLIGHTS = [
  { name: 'Meesho Seller Panel', sub: 'Valmo, Delhivery, Shadowfax', slug: 'crop/meesho', brandKey: 'meesho', cat: 'india' },
  { name: 'Flipkart Ekart Logistics', sub: 'Ekart, Smart Fulfillment', slug: 'crop/flipkart', brandKey: 'flipkart', cat: 'india' },
  { name: 'Amazon India Easy Ship', sub: 'ATS, Delhivery Surface', slug: 'crop/amazon', brandKey: 'amazon', cat: 'india' },
  { name: 'Amazon FBA US (8.5×11")', sub: 'FNSKU, Pallet & Box Labels', slug: 'us/amazon-fba-8-5x11-to-4x6', brandKey: 'amazon', cat: 'us' },
  { name: 'USPS Priority & Ground', sub: 'Click-N-Ship, Certified 4×6', slug: 'us/usps-click-n-ship-4x6-cropper', brandKey: 'usps', cat: 'us' },
  { name: 'UPS Ground & WorldShip', sub: 'UPS 4×6 Thermal Roll', slug: 'us/ups-shipping-label-cropper', brandKey: 'ups', cat: 'us' },
  { name: 'FedEx Ship Manager', sub: 'FedEx Express & Ground', slug: 'us/fedex-shipping-label-cropper', brandKey: 'fedex', cat: 'us' },
  { name: 'eBay Shipping Manager', sub: 'Standard Envelope & 4×6', slug: 'us/ebay-shipping-label-to-4x6', brandKey: 'ebay', cat: 'us' },
  { name: 'Myntra Omnichannel', sub: 'Ecom Express, Delhivery', slug: 'crop/myntra', brandKey: 'myntra', cat: 'india' },
  { name: 'Ajio Business Dispatch', sub: 'Reliance Logistics, Bluedart', slug: 'crop/ajio', brandKey: 'ajio', cat: 'india' },
  { name: 'Shopify Shipping', sub: 'Multi-courier roll labels', slug: 'us/shopify-shipping-label-cropper', brandKey: 'shopify', cat: 'us' },
  { name: 'Shiprocket Multi-Carrier', sub: 'Aggregator 4×6 Batch', slug: 'crop/shiprocket', brandKey: 'shiprocket', cat: 'india' },
  { name: 'GlowRoad Reseller', sub: 'Valmo, Shadowfax Surface', slug: 'crop/glowroad', brandKey: 'glowroad', cat: 'india' },
  { name: 'Poshmark US Prepaid', sub: 'USPS 4×6 label converter', slug: 'us/poshmark-label-to-4x6', brandKey: 'poshmark', cat: 'us' },
  { name: 'Walmart WFS Inbound', sub: 'WFS Box & Item Barcodes', slug: 'us/walmart-seller-wfs-label-cropper', brandKey: 'walmart', cat: 'us' },
  { name: 'TikTok Shop US & UK', sub: 'Prepaid Logistics 4×6', slug: 'us/tiktok-shop-label-cropper', brandKey: 'tiktok', cat: 'us' }
];
---

<BaseLayout
  title="LabelCropNow — Free Shipping Label Cropper, SKU Sorter & ZPL Studio"
  description="100% client-side shipping label cropper, SKU batch sorter, A4 4-up grid generator, and offline ZPL thermal engine for Meesho, Flipkart, Amazon, and USPS sellers."
  faq={homeFaq}
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-grid">
        <!-- Hero Left Column: Editorial Headlines, Actions, Value Badges -->
        <div class="hero-left">
          <div class="hero-badge-pill">
            <span class="pulse-dot"></span>
            <span class="font-mono text-xs">100% IN-BROWSER RAM • ZERO SERVER UPLOADS</span>
          </div>

          <h1 class="hero-title font-serif">
            Shipping label croppers & batch sorters<br />
            that <span class="highlight-text">just work.</span>
          </h1>

          <p class="hero-subtitle font-sans">
            Convert, crop, and sort multi-order PDF invoices from Meesho, Flipkart, Amazon, and USPS into clean 4×6" thermal roll stickers and A4 4-up grids — instantly in your browser. Fast, private, and free.
          </p>

          <!-- Primary Actions -->
          <div class="hero-action-buttons">
            <a href="#workbench" class="btn btn-primary btn-hero">
              <span>Crop Labels Now</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
            <a href="#features" class="btn btn-secondary btn-hero">
              <span>Explore Features</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </a>
          </div>

          <!-- Marketplaces Platform Trust Row with Real Verified Brand Assets -->
          <div class="platform-trust-row">
            <span class="trust-label font-mono">SUPPORTED CHANNELS:</span>
            <div class="trust-tags">
              <span class="trust-tag"><BrandLogo brand="meesho" size={16} /> Meesho</span>
              <span class="trust-tag"><BrandLogo brand="flipkart" size={16} /> Flipkart</span>
              <span class="trust-tag"><BrandLogo brand="amazon" size={16} /> Amazon</span>
              <span class="trust-tag"><BrandLogo brand="ekart" size={16} /> Ekart</span>
              <span class="trust-tag"><BrandLogo brand="shadowfax" size={16} /> Shadowfax</span>
              <span class="trust-tag"><BrandLogo brand="fedex" size={16} /> FedEx</span>
              <span class="trust-tag"><BrandLogo brand="usps" size={14} fallbackText="USPS" /> USPS</span>
              <span class="trust-tag"><BrandLogo brand="ups" size={14} fallbackText="UPS" /> UPS</span>
            </div>
          </div>

          <!-- 3 Value Props -->
          <div class="value-props-row">
            <div class="value-prop">
              <div class="value-prop-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <polyline points="9 12 11 14 15 10"/>
                </svg>
              </div>
              <div class="value-prop-text">
                <strong>100% Private</strong>
                <span>Zero server uploads</span>
              </div>
            </div>

            <div class="value-prop">
              <div class="value-prop-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                </svg>
              </div>
              <div class="value-prop-text">
                <strong>Instant Speed</strong>
                <span>500+ pages in 2s</span>
              </div>
            </div>

            <div class="value-prop">
              <div class="value-prop-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2">
                  <path d="M18.178 8c5.096 0 5.096 8 0 8-5.095 0-7.133-8-12.739-8-4.585 0-4.585 8 0 8 5.606 0 7.644-8 12.74-8z"/>
                </svg>
              </div>
              <div class="value-prop-text">
                <strong>Free Forever</strong>
                <span>No limits or paywalls</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Hero Right Column: 3D Isometric SaaS Mockup -->
        <div class="hero-right">
          <div class="dashboard-mockup-wrapper">
            <div class="mockup-glass-tag">
              <span class="status-live-dot"></span>
              <span>100% Client-Side Engine</span>
            </div>
            <img
              src="/images/seller_dashboard_preview.jpg"
              alt="LabelCropNow shipping label cropper and SKU sorter dashboard preview"
              class="dashboard-mockup-img"
              width="680"
              height="382"
              loading="eager"
            />
            <div class="mockup-floating-badge">
              <div class="badge-num font-mono">3.8M+</div>
              <div class="badge-label font-sans">Labels Sorted & Cropped</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Live Workbench Component (Mounted right in Hero) -->
      <div id="workbench">
        <LabelWorkbench />
      </div>
    </div>
  </section>

  <!-- Section 01: "In Three Steps" Visual Setup Workflow (SellerBox Inspired) -->
  <section class="section-block steps-section" id="how-it-works">
    <div class="container">
      <div class="section-center-heading">
        <div class="section-badge-pill">
          <span class="badge-dot bg-blue"></span>
          <span>From Multi-Page Invoices to Packing Clarity, in Three Steps</span>
        </div>
        <h2 class="section-title-large font-serif">
          Simple 3-step setup. Powerful warehouse results.
        </h2>
        <p class="section-desc-large font-sans">
          Transform your raw marketplace PDF exports into a streamlined packaging assembly line in seconds.
        </p>
      </div>

      <div class="steps-grid">
        <!-- Step 1 Card -->
        <div class="step-card">
          <div class="step-card-visual">
            <div class="step-visual-box step-box-1">
              <div class="mockup-file-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.8">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10 9 9 9 8 9"/>
                </svg>
                <div class="file-badges">
                  <span class="f-badge meesho">Meesho</span>
                  <span class="f-badge flipkart">Flipkart</span>
                  <span class="f-badge amazon">Amazon</span>
                </div>
              </div>
            </div>
          </div>
          <div class="step-card-content">
            <div class="step-pill">Step 1</div>
            <h3 class="step-title font-sans">Upload your marketplace PDF</h3>
            <p class="step-text font-sans">
              Drag and drop raw A4 invoice PDFs downloaded from Meesho Supplier Panel, Flipkart Seller Hub, or Amazon ATS. Processes 1 to 500+ pages instantly in browser RAM.
            </p>
            <div class="step-tags">
              <span class="badge badge-slate font-mono">Zero Upload Lag</span>
              <span class="badge badge-emerald font-mono">100% Private</span>
            </div>
          </div>
        </div>

        <!-- Step 2 Card -->
        <div class="step-card">
          <div class="step-card-visual">
            <img
              src="/images/label_crop_workflow.jpg"
              alt="Automatic shipping label cropping, invoice stripping, and SKU sorting workflow"
              class="step-img"
              width="400"
              height="300"
              loading="lazy"
            />
          </div>
          <div class="step-card-content">
            <div class="step-pill">Step 2</div>
            <h3 class="step-title font-sans">Auto-crop, strip invoice & sort by SKU</h3>
            <p class="step-text font-sans">
              Our vector engine strips bottom tax invoices, isolates courier barcodes (Valmo, Delhivery, Ekart), and groups labels alphabetically by SKU for high-speed batch packing.
            </p>
            <div class="step-tags">
              <span class="badge badge-blue font-mono">Vector CropBox</span>
              <span class="badge badge-amber font-mono">SKU Batching</span>
            </div>
          </div>
        </div>

        <!-- Step 3 Card -->
        <div class="step-card">
          <div class="step-card-visual">
            <img
              src="/images/thermal_grid_preview.jpg"
              alt="4x6 thermal roll stickers and A4 4-up paper saver grid printing"
              class="step-img"
              width="400"
              height="300"
              loading="lazy"
            />
          </div>
          <div class="step-card-content">
            <div class="step-pill">Step 3</div>
            <h3 class="step-title font-sans">Print 4×6" roll or A4 4-up grid</h3>
            <p class="step-text font-sans">
              Download razor-sharp vector PDFs for Zebra, Rollo, and TSC thermal roll printers, or generate an A4 4-Up grid sheet to save 75% paper on standard inkjet and laser printers.
            </p>
            <div class="step-tags">
              <span class="badge badge-purple font-mono">4×6 Thermal Roll</span>
              <span class="badge badge-emerald font-mono">75% Paper Saved</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 02: Real Seller Usage & Statistics (SellerBox Metric Grid) -->
  <section class="section-block stats-section">
    <div class="container">
      <div class="stats-header-row">
        <div>
          <div class="section-badge-pill">
            <span class="badge-dot bg-blue"></span>
            <span>Real SellerBox & Marketplace Usage</span>
          </div>
          <h2 class="stats-heading font-serif">
            Built for sellers who want faster dispatch and zero paper waste.
          </h2>
        </div>
        <p class="stats-subtext font-sans">
          Trusted daily by marketplace suppliers across India and the US to crop labels, sort SKUs, and eliminate packaging bottlenecks.
        </p>
      </div>

      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-card-top">
            <div class="stat-info">
              <p class="stat-title font-sans">Trusted Sellers</p>
              <p class="stat-value font-mono">10,000+</p>
            </div>
            <div class="stat-icon-pill bg-blue">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
          </div>
          <p class="stat-desc font-sans">
            Sellers use LabelCropNow daily to prepare shipping labels without manual software or costly subscriptions.
          </p>
        </div>

        <div class="stat-card">
          <div class="stat-card-top">
            <div class="stat-info">
              <p class="stat-title font-sans">Labels Processed</p>
              <p class="stat-value font-mono">3.8M+</p>
            </div>
            <div class="stat-icon-pill bg-emerald">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                <line x1="7" y1="7" x2="7.01" y2="7"/>
              </svg>
            </div>
          </div>
          <p class="stat-desc font-sans">
            Shipping labels cropped and sorted for 100% optical scanning accuracy across Valmo, Delhivery, Ekart, and ATS.
          </p>
        </div>

        <div class="stat-card">
          <div class="stat-card-top">
            <div class="stat-info">
              <p class="stat-title font-sans">Average Paper Saved</p>
              <p class="stat-value font-mono">68%</p>
            </div>
            <div class="stat-icon-pill bg-purple">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2.2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <line x1="3" y1="12" x2="21" y2="12"/>
                <line x1="12" y1="3" x2="12" y2="21"/>
              </svg>
            </div>
          </div>
          <p class="stat-desc font-sans">
            Cut down paper sheet expenses by up to 75% with our automated A4 4-Up grid formatting for laser and inkjet printers.
          </p>
        </div>

        <div class="stat-card">
          <div class="stat-card-top">
            <div class="stat-info">
              <p class="stat-title font-sans">Server Uploads</p>
              <p class="stat-value font-mono">0 Bytes</p>
            </div>
            <div class="stat-icon-pill bg-amber">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </div>
          </div>
          <p class="stat-desc font-sans">
            100% client-side WebAssembly execution. Customer addresses, contact numbers, and GSTINs never leave your browser.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 03: All-In-One Dispatch Command Center (SellerBox Interactive Feature Tabs) -->
  <section class="section-block command-section" id="command-center">
    <div class="container">
      <div class="section-heading-row">
        <div>
          <div class="section-badge-pill">
            <span class="badge-dot bg-blue"></span>
            <span>All-In-One Dispatch Command Center</span>
          </div>
          <h2 class="section-heading font-serif">
            Everything you need to speed up warehouse fulfillment.
          </h2>
        </div>
        <div class="section-sub-link">
          <span>Engineered for zero delays, zero server reliance, and 100% barcode clarity.</span>
        </div>
      </div>

      <div class="command-grid">
        <!-- Interactive Tabs Navigation -->
        <div class="command-tabs-list" id="commandTabs">
          <div class="command-tab active" data-tab="cropper">
            <div class="tab-indicator"></div>
            <div class="tab-header">
              <h3 class="tab-title font-sans">Intelligent 4×6 Label Cropping</h3>
              <p class="tab-summary font-sans">
                Automatically crop Meesho, Flipkart, and Amazon A4 invoices into 4×6" thermal roll stickers without losing barcodes.
              </p>
            </div>
          </div>

          <div class="command-tab" data-tab="sorter">
            <div class="tab-indicator"></div>
            <div class="tab-header">
              <h3 class="tab-title font-sans">SKU & Courier Batch Sorter</h3>
              <p class="tab-summary font-sans">
                Extract product codes and courier routes to organize 500+ dispatch slips alphabetically for continuous assembly-line packing.
              </p>
            </div>
          </div>

          <div class="command-tab" data-tab="grid">
            <div class="tab-indicator"></div>
            <div class="tab-header">
              <h3 class="tab-title font-sans">A4 4-Up Grid Paper Saver</h3>
              <p class="tab-summary font-sans">
                Arrange 4 shipping labels in a clean 2×2 grid with cutting guides, saving 75% paper on office laser or inkjet printers.
              </p>
            </div>
          </div>

          <div class="command-tab" data-tab="zpl">
            <div class="tab-indicator"></div>
            <div class="tab-header">
              <h3 class="tab-title font-sans">Offline Zebra ZPL II Studio</h3>
              <p class="tab-summary font-sans">
                Preview raw Zebra programming language code directly in browser Canvas and export to 203 DPI / 300 DPI PDF stickers.
              </p>
            </div>
          </div>
        </div>

        <!-- Dynamic Feature Showcase Display -->
        <div class="command-preview-panel">
          <!-- Cropper Showcase -->
          <div class="showcase-content active" id="showcase-cropper">
            <div class="showcase-card">
              <div class="showcase-header">
                <span class="badge badge-emerald font-mono">100% Vector Lossless</span>
                <span class="font-mono text-xs text-slate-400">CropBox Engine</span>
              </div>
              <h4 class="showcase-heading font-serif">Instant A4 to 4×6" Thermal Cropper</h4>
              <p class="showcase-desc font-sans">
                Unlike online tools that turn PDFs into blurry pixel images, LabelCropNow modifies vector coordinates directly. Barcodes scan with 100% optical accuracy at sorting hubs.
              </p>
              <div class="showcase-bullets">
                <div class="bullet-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Strips bottom tax invoice half automatically</span>
                </div>
                <div class="bullet-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Pre-configured crop dimensions for Meesho, Flipkart & Amazon</span>
                </div>
                <div class="bullet-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Export clean single-page thermal roll PDF in seconds</span>
                </div>
              </div>
              <div class="showcase-action">
                <a href="#workbench" class="btn btn-primary">Open Cropper Workbench →</a>
              </div>
            </div>
          </div>

          <!-- Sorter Showcase -->
          <div class="showcase-content" id="showcase-sorter">
            <div class="showcase-card">
              <div class="showcase-header">
                <span class="badge badge-amber font-mono">Assembly Line Ready</span>
                <span class="font-mono text-xs text-slate-400">Smart Text Extractor</span>
              </div>
              <h4 class="showcase-heading font-serif">SKU & Courier Batch Sorting</h4>
              <p class="showcase-desc font-sans">
                Eliminate wrong-item dispatch mistakes by sorting labels by product SKU. Your warehouse packing team can pack all units of a single product SKU in one continuous batch.
              </p>
              <div class="showcase-bullets">
                <div class="bullet-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Group by Courier: Valmo, Ekart, Delhivery, ATS, Shadowfax</span>
                </div>
                <div class="bullet-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Sort alphabetically by SKU code or Item Title</span>
                </div>
                <div class="bullet-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Multi-quantity order badge alerts prevent missing pieces</span>
                </div>
              </div>
              <div class="showcase-action">
                <a href="/sort-shipping-labels-by-sku/" class="btn btn-primary">Launch SKU Sorter →</a>
              </div>
