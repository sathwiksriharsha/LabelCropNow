    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.06);
  }

  .step-card-visual {
    height: 220px;
    border-radius: 16px;
    overflow: hidden;
    background: #f8fafc;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .step-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .step-box-1 {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
  }

  .mockup-file-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .file-badges {
    display: flex;
    gap: 0.4rem;
  }

  .f-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
  }

  .f-badge.meesho { background: #fdf2f8; color: #db2777; border: 1px solid #fbcfe8; }
  .f-badge.flipkart { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }
  .f-badge.amazon { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }

  .step-card-content {
    padding: 1.5rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .step-pill {
    display: inline-block;
    background: #2563eb;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 8px;
    width: fit-content;
    margin-bottom: 0.85rem;
  }

  .step-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.65rem;
    letter-spacing: -0.015em;
  }

  .step-text {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .step-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  /* -------------------------------------------------------------
     SECTION 02: REAL SELLER STATS (SellerBox Metric Grid)
     ------------------------------------------------------------- */
  .stats-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .stats-heading {
    font-size: 2.45rem;
    font-weight: 500;
    color: var(--text-main);
    letter-spacing: -0.025em;
    line-height: 1.15;
    max-width: 680px;
  }

  .stats-subtext {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 420px;
    line-height: 1.6;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .stat-card {
    background: #ffffff;
    border: 4px solid #f1f5f9;
    border-radius: 20px;
    padding: 1.5rem;
    transition: all 0.25s ease;
  }

  .stat-card:hover {
    border-color: #e2e8f0;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.05);
  }

  .stat-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
  }

  .stat-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: #64748b;
    margin-bottom: 0.35rem;
  }

  .stat-value {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1;
  }

  .stat-icon-pill {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .stat-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* -------------------------------------------------------------
     SECTION 03: COMMAND CENTER (SellerBox Interactive Tabs)
     ------------------------------------------------------------- */
  .command-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2rem;
    align-items: stretch;
  }

  .command-tabs-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .command-tab {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: #f8fafc;
    border: 3px solid #f1f5f9;
    border-radius: 18px;
    padding: 1.25rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .command-tab:hover {
    background: #f1f5f9;
  }

  .command-tab.active {
    background: #ffffff;
    border-color: #2563eb;
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.08);
  }

  .tab-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #cbd5e1;
    margin-top: 5px;
    flex-shrink: 0;
    transition: background-color 0.2s ease;
  }

  .command-tab.active .tab-indicator {
    background: #2563eb;
    box-shadow: 0 0 8px rgba(37, 99, 235, 0.5);
  }

  .tab-header {
    display: flex;
    flex-direction: column;
  }

  .tab-title {
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .tab-summary {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .command-preview-panel {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 2.25rem;
    box-shadow: 0 8px 30px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .showcase-content {
    display: none;
  }

  .showcase-content.active {
    display: block;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .showcase-card {
    display: flex;
    flex-direction: column;
  }

  .showcase-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .showcase-heading {
    font-size: 2rem;
    font-weight: 500;
    color: var(--text-main);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .showcase-desc {
    font-size: 0.98rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .showcase-bullets {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .bullet-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.92rem;
    color: var(--text-main);
    font-weight: 500;
  }

  .showcase-action {
    display: flex;
  }

  /* -------------------------------------------------------------
     SECTION 04: FEATURES FOR E-COMMERCE SELLERS (User Image 1)
     ------------------------------------------------------------- */
  .features-showcase-section {
    background: #ffffff;
  }

  .features-header {
    margin-bottom: 3rem;
  }

  .text-center {
    text-align: center;
  }

  .features-main-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #1e3a8a;
    background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
  }

  .features-title-underline {
    width: 48px;
    height: 4px;
    background: #2563eb;
    border-radius: 2px;
    margin: 0.65rem auto 1.5rem auto;
  }

  .features-subtitle {
    font-size: 1.05rem;
    color: #64748b;
    max-width: 680px;
    margin: 0 auto 2.25rem auto;
    line-height: 1.6;
  }

  .smart-filter-pills {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .smart-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    color: #475569;
    padding: 0.45rem 1.1rem;
    border-radius: 9999px;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: var(--font-sans);
  }

  .smart-pill:hover {
    border-color: #cbd5e1;
    background: #f8fafc;
    color: #0f172a;
  }

  .smart-pill.active {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.15);
  }

  .smart-features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .smart-feature-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 20px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    text-decoration: none !important;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    transition: all 0.22s ease;
  }

  .smart-feature-card:hover {
    transform: translateY(-3px);
    border-color: #93c5fd;
    box-shadow: 0 12px 30px rgba(37, 99, 235, 0.08);
  }

  .smart-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .smart-brand-logo {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    object-fit: contain;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
  }

  .smart-custom-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .smart-badge {
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .badge-popular { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }
  .badge-sku { background: #fff1f2; color: #e11d48; border: 1px solid #fecdd3; }
  .badge-fast { background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; }
  .badge-aggregator { background: #faf5ff; color: #7c3aed; border: 1px solid #e9d5ff; }
  .badge-global { background: #f0f9ff; color: #0284c7; border: 1px solid #bae6fd; }
  .badge-eco { background: #ecfdf5; color: #047857; border: 1px solid #6ee7b7; }
  .badge-zpl { background: #f8fafc; color: #334155; border: 1px solid #cbd5e1; }

  .smart-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.5rem;
    letter-spacing: -0.015em;
  }

  .smart-card-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  /* -------------------------------------------------------------
     SECTION 05: TOOL DIRECTORY & PRESETS (User Image 2)
     ------------------------------------------------------------- */
  .search-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 680px;
    margin-bottom: 2.5rem;
  }

  .search-input-box {
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: 9999px;
    padding: 0.4rem 0.5rem 0.4rem 1.1rem;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .search-input-box:focus-within {
    border-color: #2563eb;
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.12);
  }

  .search-icon {
    color: var(--text-dim);
    margin-right: 0.75rem;
    flex-shrink: 0;
  }

  .search-input {
    width: 100%;
    border: none;
    outline: none;
    font-size: 0.92rem;
    color: var(--text-main);
    background: transparent;
    font-family: var(--font-sans);
  }

  .search-input::placeholder {
    color: #94a3b8;
  }

  .filter-pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-pill {
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 500;
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: var(--font-sans);
  }

  .filter-pill:hover {
    background: #f8fafc;
    border-color: var(--border-medium);
    color: var(--text-main);
  }

  .filter-pill.active {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  .subsection-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    height: 100%;
    transition: all 0.2s ease;
  }

  .tool-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
    border-color: var(--border-medium);
  }

  .card-format-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }

  .format-arrow {
    color: var(--text-dim);
    font-size: 0.85rem;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.5rem;
    letter-spacing: -0.015em;
  }

  .card-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 1.5rem;
  }

  .card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .btn-text {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-main);
    transition: color 0.15s ease;
  }

  .tool-card:hover .btn-text {
    color: #2563eb;
  }

  .feature-icon-box {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .bg-purple { background: #faf5ff; border: 1px solid #e9d5ff; }
  .bg-amber { background: #fffbeb; border: 1px solid #fde68a; }
  .bg-rose { background: #fff1f2; border: 1px solid #fecdd3; }
  .bg-emerald { background: #ecfdf5; border: 1px solid #a7f3d0; }
  .bg-blue { background: #eff6ff; border: 1px solid #bfdbfe; }
  .bg-cyan { background: #f0f9ff; border: 1px solid #bae6fd; }

  /* Marketplace Presets Grid (Exact Match of User Image 2 with Real Brand Logos) */
  .preset-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.1rem;
    text-decoration: none;
    border-radius: 14px;
    transition: all 0.2s ease;
  }

  .preset-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
    border-color: var(--border-medium);
  }

  .preset-logo-wrapper {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 2px;
    flex-shrink: 0;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    overflow: hidden;
  }

  .preset-brand-logo {
    width: 100%;
    height: 100%;
    border-radius: 8px;
    object-fit: contain;
    display: block;
  }

  .preset-info {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    margin-right: auto;
  }

  .preset-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .preset-meta {
    font-size: 0.72rem;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* -------------------------------------------------------------
     SECTION 07: BENEFITS (SellerBox 6-Card Grid)
     ------------------------------------------------------------- */
  .benefit-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    border: 4px solid #f1f5f9;
    border-radius: 20px;
    padding: 1.75rem;
    transition: all 0.25s ease;
  }

  .benefit-card:hover {
    border-color: #e2e8f0;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
  }

  .benefit-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .benefit-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .benefit-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* -------------------------------------------------------------
     SECTION 08: FAQ ACCORDION (ailabelcrop Inspired)
     ------------------------------------------------------------- */
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 880px;
    margin: 0 auto;
  }

  .faq-item {
    padding: 0;
    overflow: hidden;
    border: 2px solid #e2e8f0;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item.active {
    border-color: #2563eb;
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.08);
  }

  .faq-question-btn {
    width: 100%;
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    gap: 1rem;
    transition: background-color 0.15s ease;
  }

  .faq-question-btn:hover {
    background: #f8fafc;
  }

  .faq-question-text {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .faq-chevron {
    color: #2563eb;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .faq-item.active .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer-panel {
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-answer-text {
    padding: 0 1.5rem 1.25rem;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* -------------------------------------------------------------
     RESPONSIVE BREAKPOINTS
     ------------------------------------------------------------- */
  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-right {
      order: -1;
    }

    .hero-title {
      font-size: 2.85rem;
    }

    .steps-grid {
      grid-template-columns: 1fr;
    }

    .smart-features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .command-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2.25rem;
    }

    .smart-features-grid {
      grid-template-columns: 1fr;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .section-title-large {
      font-size: 2.1rem;
    }

    .features-main-title {
      font-size: 2rem;
    }

    .value-props-row {
      gap: 1rem;
    }

    .hero-section {
      padding: 2rem 0 1rem;
    }

    .hero-title {
      font-size: 2rem;
      line-height: 1.2;
    }

    .hero-subtitle {
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
    }

    .hero-action-buttons {
      flex-direction: column;
      width: 100%;
      gap: 0.65rem;
    }

    .hero-action-buttons .btn {
      width: 100%;
      text-align: center;
    }

    .platform-trust-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .trust-tags {
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .trust-tag {
      font-size: 0.72rem;
      padding: 0.25rem 0.55rem;
    }

    .smart-filter-pills,
    .filter-pills-row {
      overflow-x: auto;
      flex-wrap: nowrap;
      justify-content: flex-start;
      padding-bottom: 0.5rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none !important;
      -ms-overflow-style: none !important;
      width: 100%;
    }

    .smart-filter-pills::-webkit-scrollbar,
    .filter-pills-row::-webkit-scrollbar {
      display: none !important;
      width: 0 !important;
      height: 0 !important;
    }

    .smart-pill,
