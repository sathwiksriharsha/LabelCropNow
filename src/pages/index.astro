<!-- Client Script for Search, Pill Filtering, Command Center Tabs, Smart Features & FAQ Accordion -->
<script>
  // 1. Live Search & Pill Filtering
  const searchInput = document.getElementById('toolSearchInput') as HTMLInputElement;
  const filterPills = document.querySelectorAll('.filter-pill');
  const allCards = document.querySelectorAll('#popularToolsGrid .tool-card, #batchToolsGrid .tool-card, #presetsGrid .preset-card');

  function applyFilter(query: string, category: string) {
    const q = query.toLowerCase().trim();

    allCards.forEach((card) => {
      const el = card as HTMLElement;
      const text = el.innerText.toLowerCase();
      const cat = el.getAttribute('data-category') || '';
      const name = el.getAttribute('data-name') || '';
      const sub = el.getAttribute('data-sub') || '';

      const matchesQuery = !q || text.includes(q) || name.includes(q) || sub.includes(q);
      const matchesCategory =
        category === 'all' ||
        cat.includes(category) ||
        (category === 'india' && (cat.includes('india') || name.includes('meesho') || name.includes('flipkart'))) ||
        (category === 'us' && (cat.includes('us') || name.includes('amazon') || name.includes('usps')));

      if (matchesQuery && matchesCategory) {
        el.style.display = '';
      } else {
        el.style.display = 'none';
      }
    });
  }

  searchInput?.addEventListener('input', () => {
    const activePill = document.querySelector('.filter-pill.active');
    const category = activePill?.getAttribute('data-filter') || 'all';
    applyFilter(searchInput.value, category);
  });

  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      filterPills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      const category = pill.getAttribute('data-filter') || 'all';
      applyFilter(searchInput?.value || '', category);
    });
  });

  // 2. Command Center Tabs Showcase
  const commandTabs = document.querySelectorAll('.command-tab');
  const showcases = document.querySelectorAll('.showcase-content');

  commandTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');
      commandTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      showcases.forEach((sc) => {
        if (sc.id === `showcase-${target}`) {
          sc.classList.add('active');
        } else {
          sc.classList.remove('active');
        }
      });
    });
  });

  // 3. Smart Features Filter Pills (User Image 1)
  const smartPills = document.querySelectorAll('.smart-pill');
  const smartCards = document.querySelectorAll('.smart-feature-card');

  smartPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      smartPills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      const filter = pill.getAttribute('data-smart-filter') || 'all';

      smartCards.forEach((card) => {
        const el = card as HTMLElement;
        const cat = el.getAttribute('data-smart-cat') || '';
        if (filter === 'all' || cat.includes(filter)) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });

  // 4. FAQ Accordion Click Handler
  const faqButtons = document.querySelectorAll('.faq-question-btn');
  faqButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item') as HTMLElement;
      const panel = item?.querySelector('.faq-answer-panel') as HTMLElement;
      const isCurrentlyActive = item?.classList.contains('active');

      // Close all other items
      document.querySelectorAll('.faq-item').forEach((otherItem) => {
        if (otherItem !== item) {
          otherItem.classList.remove('active');
          const otherPanel = otherItem.querySelector('.faq-answer-panel') as HTMLElement;
          if (otherPanel) otherPanel.style.maxHeight = '0px';
          const otherBtn = otherItem.querySelector('.faq-question-btn');
          otherBtn?.setAttribute('aria-expanded', 'false');
        }
      });

      if (isCurrentlyActive) {
        item.classList.remove('active');
        if (panel) panel.style.maxHeight = '0px';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        item.classList.add('active');
        if (panel) panel.style.maxHeight = panel.scrollHeight + 'px';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

